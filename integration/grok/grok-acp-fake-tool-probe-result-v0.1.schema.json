{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lif/grok-acp-fake-tool-probe-result-v0.1.schema.json",
  "title": "Grok ACP fake-tool probe result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "probe_kind",
    "probe_id",
    "scenario",
    "valid",
    "started_at",
    "completed_at",
    "binary",
    "artifacts",
    "acp",
    "session_evidence",
    "provider",
    "process",
    "controls",
    "checks",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "probe_kind": { "const": "grok-acp-fake-tool-continuity" },
    "probe_id": { "type": "string", "pattern": "^ACPTOOL-[0-9a-f]{32}$" },
    "scenario": { "enum": ["allow_once", "cancel_permission"] },
    "valid": { "type": "boolean" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "binary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "locked_sha256", "version", "authenticode_status"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "locked_sha256": { "$ref": "#/$defs/sha256" },
        "version": { "type": "string", "minLength": 1 },
        "authenticode_status": { "const": "Valid" }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transcript",
        "provider_result",
        "provider_private_capture",
        "workspace_trust_preflight",
        "workspace_trust_launch",
        "workspace_trust_postrun",
        "session_events",
        "session_updates"
      ],
      "properties": {
        "transcript": { "$ref": "#/$defs/artifact" },
        "provider_result": { "$ref": "#/$defs/artifact" },
        "provider_private_capture": { "$ref": "#/$defs/artifact" },
        "workspace_trust_preflight": { "$ref": "#/$defs/artifact" },
        "workspace_trust_launch": { "$ref": "#/$defs/artifact" },
        "workspace_trust_postrun": { "$ref": "#/$defs/artifact" },
        "session_events": { "$ref": "#/$defs/artifact" },
        "session_updates": { "$ref": "#/$defs/artifact" }
      }
    },
    "acp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "session_id",
        "request_methods",
        "update_types",
        "tool_call_id",
        "tool_call_count",
        "tool_update_count",
        "terminal_tool_update_count",
        "tool_statuses",
        "permission_request_count",
        "permission_option_kinds",
        "permission_outcome",
        "cancel_notification_sent",
        "prompt_response_count",
        "prompt_stop_reason",
        "unexpected_message_count",
        "parse_failure_count"
      ],
      "properties": {
        "protocol_version": { "const": 1 },
        "session_id": { "type": "string", "minLength": 1 },
        "request_methods": {
          "type": "array",
          "prefixItems": [
            { "const": "initialize" },
            { "const": "session/new" },
            { "const": "session/prompt" }
          ],
          "items": false
        },
        "update_types": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "tool_call_id": { "type": "string", "minLength": 1 },
        "tool_call_count": { "type": "integer", "minimum": 0 },
        "tool_update_count": { "type": "integer", "minimum": 0 },
        "terminal_tool_update_count": { "type": "integer", "minimum": 0 },
        "tool_statuses": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "permission_request_count": { "type": "integer", "minimum": 0 },
        "permission_option_kinds": {
          "type": "array",
          "items": { "enum": ["allow_once", "allow_always", "reject_once", "reject_always"] },
          "uniqueItems": true
        },
        "permission_outcome": { "enum": ["allow_once", "cancelled"] },
        "cancel_notification_sent": { "type": "boolean" },
        "prompt_response_count": { "type": "integer", "minimum": 0 },
        "prompt_stop_reason": { "enum": ["end_turn", "cancelled"] },
        "unexpected_message_count": { "type": "integer", "minimum": 0 },
        "parse_failure_count": { "type": "integer", "minimum": 0 }
      }
    },
    "session_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discovered",
        "event_types",
        "update_types",
        "tool_call_ids",
        "permission_decisions",
        "completed_tool_event_count"
      ],
      "properties": {
        "discovered": { "type": "boolean" },
        "event_types": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "update_types": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "tool_call_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "permission_decisions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "completed_tool_event_count": { "type": "integer", "minimum": 0 }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario",
        "terminal_state",
        "primary_request_count",
        "auxiliary_request_count",
        "second_request_observed",
        "reasoning_marker_preserved",
        "tool_call_id_preserved",
        "tool_result_observed",
        "tool_result_marker_observed",
        "real_model_invoked"
      ],
      "properties": {
        "scenario": { "enum": ["tool-continuity", "tool-cancel"] },
        "terminal_state": { "enum": ["succeeded", "timed_out"] },
        "primary_request_count": { "type": "integer", "minimum": 0 },
        "auxiliary_request_count": { "type": "integer", "minimum": 0 },
        "second_request_observed": { "type": "boolean" },
        "reasoning_marker_preserved": { "type": "boolean" },
        "tool_call_id_preserved": { "type": "boolean" },
        "tool_result_observed": { "type": "boolean" },
        "tool_result_marker_observed": { "type": "boolean" },
        "real_model_invoked": { "const": false }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exit_code",
        "timed_out",
        "duration_ms",
        "job_object_created",
        "job_object_assigned",
        "job_object_closed"
      ],
      "properties": {
        "exit_code": { "type": "integer" },
        "timed_out": { "type": "boolean" },
        "duration_ms": { "type": "number", "minimum": 0 },
        "job_object_created": { "type": "boolean" },
        "job_object_assigned": { "type": "boolean" },
        "job_object_closed": { "type": "boolean" }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loopback_only_provider",
        "clean_environment",
        "credential_value_recorded",
        "outbound_block_created",
        "outbound_rules_removed",
        "remaining_rule_count",
        "workspace_disposable",
        "workspace_modified",
        "output_overwritten"
      ],
      "properties": {
        "loopback_only_provider": { "type": "boolean" },
        "clean_environment": { "type": "boolean" },
        "credential_value_recorded": { "type": "boolean" },
        "outbound_block_created": { "type": "boolean" },
        "outbound_rules_removed": { "type": "boolean" },
        "remaining_rule_count": { "type": "integer", "minimum": 0 },
        "workspace_disposable": { "type": "boolean" },
        "workspace_modified": { "type": "boolean" },
        "output_overwritten": { "type": "boolean" }
      }
    },
    "checks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "boolean" }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "valid": { "const": true } }, "required": ["valid"] },
      "then": {
        "properties": {
          "checks": { "additionalProperties": { "const": true } }
        }
      }
    }
  ]
}
