{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lif/grok-acp-fake-tool-probe-verification-v0.1.schema.json",
  "title": "Grok ACP fake-tool probe verification v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verification_kind",
    "valid",
    "probe_id",
    "result_sha256",
    "checks",
    "errors"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "verification_kind": { "const": "grok-acp-fake-tool-probe-verification" },
    "valid": { "type": "boolean" },
    "probe_id": { "type": "string", "pattern": "^ACPTOOL-[0-9a-f]{32}$" },
    "result_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_schema_valid",
        "result_valid_flag",
        "binary_lock_matches",
        "artifact_digests_match",
        "transcript_projection_matches",
        "provider_capture_matches",
        "session_evidence_matches",
        "workspace_receipts_match",
        "scenario_semantics_match",
        "safety_checks_all_true"
      ],
      "properties": {
        "result_schema_valid": { "type": "boolean" },
        "result_valid_flag": { "type": "boolean" },
        "binary_lock_matches": { "type": "boolean" },
        "artifact_digests_match": { "type": "boolean" },
        "transcript_projection_matches": { "type": "boolean" },
        "provider_capture_matches": { "type": "boolean" },
        "session_evidence_matches": { "type": "boolean" },
        "workspace_receipts_match": { "type": "boolean" },
        "scenario_semantics_match": { "type": "boolean" },
        "safety_checks_all_true": { "type": "boolean" }
      }
    },
    "errors": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
