{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.fep.invalid/integration/grok/grok-windows-child-tree-probe-verification/v0.1/schema.json",
  "title": "Grok Windows Child-Tree Probe Verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verifier",
    "result",
    "scenario",
    "valid",
    "checks",
    "replay",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "verifier": { "const": "grok-windows-child-tree-independent" },
    "result": { "$ref": "#/$defs/artifact" },
    "scenario": {
      "enum": ["tool_timeout", "task_cancel", "parent_exit"]
    },
    "valid": { "type": "boolean" },
    "checks": {
      "type": "object",
      "minProperties": 20,
      "additionalProperties": { "const": true }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_count",
        "primary_request_count",
        "tool_sequence",
        "live_nonce_process_count",
        "marker_projection"
      ],
      "properties": {
        "role_count": { "const": 3 },
        "primary_request_count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4
        },
        "tool_sequence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "enum": [
              "run_terminal_command",
              "kill_command_or_subagent",
              "get_command_or_subagent_output"
            ]
          }
        },
        "live_nonce_process_count": { "const": 0 },
        "marker_projection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root", "child", "grandchild"],
          "properties": {
            "root": { "$ref": "#/$defs/markerPair" },
            "child": { "$ref": "#/$defs/markerPair" },
            "grandchild": { "$ref": "#/$defs/markerPair" }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "markerPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stdout", "stderr"],
      "properties": {
        "stdout": { "type": "boolean" },
        "stderr": { "type": "boolean" }
      }
    }
  }
}
