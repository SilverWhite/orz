{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lif.local/schema/grok-event-bridge-manifest-v0.1.schema.json",
  "title": "Grok event completeness bridge manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "bridge_kind", "bridge_id", "created_at", "run_id", "session_id",
    "source_result_schema", "source_artifacts", "event_journal", "counts", "ordering",
    "completeness", "checks", "valid", "limitations"
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "state", "sensitivity", "parsed"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "state": { "const": "available" },
        "sensitivity": {
          "enum": [
            "metadata", "content_bearing_fake_fixture",
            "sealed_private_candidate_plaintext_source"
          ]
        },
        "parsed": { "type": "boolean" }
      }
    }
  },
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "bridge_kind": { "const": "grok-local-event-completeness" },
    "bridge_id": { "type": "string", "pattern": "^BRIDGE-[0-9a-f]{32}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "run_id": { "type": "string", "pattern": "^FAKE-[0-9a-f]{32}$" },
    "session_id": { "type": "string", "format": "uuid" },
    "source_result_schema": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "source_artifacts": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/artifact" },
      "required": [
        "source_result", "grok_stdout", "provider_result", "provider_private",
        "trust_preflight", "trust_launch", "trust_postrun", "session_events",
        "session_updates", "session_chat_history", "session_summary", "session_signals",
        "trace_status", "export_status"
      ]
    },
    "event_journal": { "$ref": "#/$defs/artifact" },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events", "by_source", "by_canonical_type"],
      "properties": {
        "events": { "type": "integer", "minimum": 1 },
        "by_source": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "by_canonical_type": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "ordering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bridge_sequence_semantics", "cross_source_runtime_order", "source_order_preserved"],
      "properties": {
        "bridge_sequence_semantics": { "const": "deterministic_source_append_order" },
        "cross_source_runtime_order": { "const": "not_established" },
        "source_order_preserved": { "const": true }
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall", "stdout_tool_lifecycle", "session_event_tool_lifecycle",
        "session_update_tool_identity", "provider_tool_continuity", "trace", "export",
        "missing_observations"
      ],
      "properties": {
        "overall": { "enum": ["partial", "invalid"] },
        "stdout_tool_lifecycle": { "enum": ["observed", "absent"] },
        "session_event_tool_lifecycle": { "enum": ["observed", "absent", "not_applicable"] },
        "session_update_tool_identity": { "enum": ["observed", "absent", "not_applicable"] },
        "provider_tool_continuity": { "enum": ["observed", "absent", "not_applicable"] },
        "trace": { "enum": ["available", "failed", "timed_out", "unavailable", "unknown"] },
        "export": { "enum": ["available", "failed", "timed_out", "unavailable", "unknown"] },
        "missing_observations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": { "type": "boolean" },
      "required": [
        "source_result_valid", "source_result_artifacts_match", "session_id_matches_summary",
        "workspace_matches_summary", "trust_receipts_valid_and_unchanged", "source_json_lines_parse",
        "source_order_preserved", "payloads_exist_before_references", "bridge_sequence_contiguous",
        "event_hash_chain_valid", "terminal_observed", "tool_lifecycle_observed_when_expected",
        "raw_content_omitted_from_bridge", "debug_capture_disabled"
      ]
    },
    "valid": { "type": "boolean" },
    "limitations": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
