{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.fep.invalid/integration/grok-real-deepseek-plan/v0.1/schema.json",
  "title": "Grok Real DeepSeek Conformance Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_kind",
    "created_at",
    "confirmation_summary",
    "confirmation_summary_sha256",
    "confirmation_token_hint",
    "execution",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "plan_kind": { "const": "grok-real-deepseek-conformance" },
    "created_at": { "type": "string", "minLength": 1 },
    "confirmation_summary": { "type": "object" },
    "confirmation_summary_sha256": { "$ref": "#/$defs/sha256" },
    "confirmation_token_hint": { "pattern": "^ALLOW-GROK-[A-F0-9]{12}$" },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credential_read",
        "grok_started",
        "network_attempted",
        "billable_request_made"
      ],
      "properties": {
        "credential_read": { "const": false },
        "grok_started": { "const": false },
        "network_attempted": { "const": false },
        "billable_request_made": { "const": false }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
