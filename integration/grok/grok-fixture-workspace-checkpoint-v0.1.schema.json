{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lif.local/schema/grok-fixture-workspace-checkpoint-v0.1.schema.json",
  "title": "Grok disposable fixture workspace checkpoint v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_kind", "checkpoint_id", "created_at", "workspace", "policy", "state", "checks", "valid", "limitations"],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "workspace_id": { "type": "string", "pattern": "^FIXTURE-[0-9a-f]{32}$" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "bytes", "sha256"],
      "properties": {
        "relative_path": { "type": "string", "minLength": 1, "pattern": "^[^\\\\]+(?:/[^\\\\]+)*$" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "receipt_kind": { "const": "grok-fixture-workspace-checkpoint" },
    "checkpoint_id": { "type": "string", "pattern": "^CHECKPOINT-[0-9a-f]{32}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_path", "workspace_id", "disposable_marker"],
      "properties": {
        "canonical_path": { "type": "string", "minLength": 1 },
        "workspace_id": { "$ref": "#/$defs/workspace_id" },
        "disposable_marker": { "$ref": "#/$defs/file" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "max_files", "max_bytes", "stability_passes", "reparse_points", "casefold_collisions"],
      "properties": {
        "mode": { "const": "hash_only_non_restoring" },
        "max_files": { "type": "integer", "minimum": 1 },
        "max_bytes": { "type": "integer", "minimum": 1 },
        "stability_passes": { "const": 2 },
        "reparse_points": { "const": "deny" },
        "casefold_collisions": { "const": "deny" }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_count", "total_bytes", "aggregate_sha256", "files"],
      "properties": {
        "file_count": { "type": "integer", "minimum": 1 },
        "total_bytes": { "type": "integer", "minimum": 1 },
        "aggregate_sha256": { "$ref": "#/$defs/sha256" },
        "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposable_marker_valid", "output_outside_workspace", "scan_complete_within_limits", "regular_files_only", "casefold_paths_unique"],
      "properties": {
        "disposable_marker_valid": { "type": "boolean" },
        "output_outside_workspace": { "type": "boolean" },
        "scan_complete_within_limits": { "type": "boolean" },
        "regular_files_only": { "type": "boolean" },
        "casefold_paths_unique": { "type": "boolean" }
      }
    },
    "valid": { "type": "boolean" },
    "limitations": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 1 } }
  }
}
