{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.fep.invalid/integration/grok-real-deepseek-result/v0.1/schema.json",
  "title": "Grok Real DeepSeek Conformance Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_kind",
    "valid",
    "started_at",
    "completed_at",
    "confirmation_summary_sha256",
    "request_count",
    "retry_count",
    "provider",
    "endpoint",
    "model",
    "marker_matched",
    "response_content_recorded",
    "credential_value_recorded",
    "process",
    "usage",
    "controls",
    "artifact_leak_scan",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "result_kind": { "const": "grok-real-deepseek-conformance" },
    "valid": { "const": true },
    "started_at": { "type": "string", "minLength": 1 },
    "completed_at": { "type": "string", "minLength": 1 },
    "confirmation_summary_sha256": { "$ref": "#/$defs/sha256" },
    "request_count": { "const": 1 },
    "retry_count": { "const": 0 },
    "provider": { "const": "deepseek" },
    "endpoint": { "const": "https://api.deepseek.com/chat/completions" },
    "model": { "const": "deepseek-v4-pro" },
    "marker_matched": { "const": true },
    "response_content_recorded": { "const": false },
    "credential_value_recorded": { "const": false },
    "process": { "type": "object" },
    "usage": { "type": "object" },
    "controls": { "type": "object" },
    "artifact_leak_scan": {
      "type": "object",
      "required": ["complete", "actual_credential_read_for_scan", "hit_count"],
      "properties": {
        "complete": { "const": true },
        "actual_credential_read_for_scan": { "const": false },
        "hit_count": { "const": 0 }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
