{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.fep-agent.invalid/schema/historical-excerpt-provenance-v0.1.schema.json",
  "title": "FEP Historical Excerpt Provenance v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "case_id",
    "visibility",
    "normalization",
    "excerpts",
    "limitations"
  ],
  "properties": {
    "record_type": { "const": "historical_excerpt_provenance" },
    "schema_version": { "const": "0.1.0-draft" },
    "case_id": { "type": "string", "pattern": "^FEP-REG-[0-9]{3}$" },
    "visibility": { "const": "reviewer_only" },
    "normalization": { "const": "rstrip_each_line_then_join_lf" },
    "excerpts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixture_path",
          "fixture_sha256",
          "source_path",
          "source_sha256",
          "line_start",
          "line_end",
          "normalized_excerpt_sha256",
          "role"
        ],
        "properties": {
          "fixture_path": { "type": "string", "minLength": 1 },
          "fixture_sha256": { "$ref": "#/$defs/sha256" },
          "source_path": { "type": "string", "minLength": 1 },
          "source_sha256": { "$ref": "#/$defs/sha256" },
          "line_start": { "type": "integer", "minimum": 1 },
          "line_end": { "type": "integer", "minimum": 1 },
          "normalized_excerpt_sha256": { "$ref": "#/$defs/sha256" },
          "role": { "type": "string", "minLength": 1 }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
