{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.fep-agent.invalid/schema/coverage-matrix-v0.1.schema.json",
  "title": "FEP Agent Regression Coverage Matrix v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "matrix_id",
    "created_at",
    "revised_at",
    "matrix_revision",
    "status",
    "revision_history",
    "source_corpus",
    "definitions",
    "readiness_summary",
    "clusters",
    "next_actions_before_holdout"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0-draft" },
    "matrix_id": { "$ref": "#/$defs/nonEmptyString" },
    "created_at": { "type": "string", "format": "date" },
    "revised_at": { "type": "string", "format": "date" },
    "matrix_revision": { "type": "integer", "minimum": 1 },
    "status": { "$ref": "#/$defs/nonEmptyString" },
    "revision_history": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/revisionRecord" }
    },
    "source_corpus": { "$ref": "#/$defs/sourceCorpus" },
    "definitions": { "$ref": "#/$defs/definitions" },
    "readiness_summary": { "$ref": "#/$defs/readiness" },
    "clusters": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/cluster" }
    },
    "next_actions_before_holdout": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nextAction" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "caseId": {
      "type": "string",
      "pattern": "^FEP-(?:REG|SYN)-[0-9]{3}$"
    },
    "revisionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "date", "summary"],
      "properties": {
        "revision": { "type": "integer", "minimum": 1 },
        "date": { "type": "string", "format": "date" },
        "summary": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*(?:-[A-Z][A-Z0-9_]*)+-[0-9]{3}$"
    },
    "sourceCorpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpus_id", "corpus_revision", "path", "oracle_default_mode"],
      "properties": {
        "corpus_id": { "$ref": "#/$defs/nonEmptyString" },
        "corpus_revision": { "type": "integer", "minimum": 1 },
        "path": { "$ref": "#/$defs/nonEmptyString" },
        "oracle_default_mode": { "enum": ["discussion", "guarded", "strict"] }
      }
    },
    "definitions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corpus_frequency_threshold",
        "corpus_frequency_note",
        "contrast_types",
        "coverage_statuses",
        "independence_rule"
      ],
      "properties": {
        "corpus_frequency_threshold": { "type": "integer", "minimum": 1 },
        "corpus_frequency_note": { "$ref": "#/$defs/nonEmptyString" },
        "contrast_types": {
          "type": "object",
          "additionalProperties": false,
          "required": ["permission_reversal", "root_cause_contrast", "mode_boundary"],
          "properties": {
            "permission_reversal": { "$ref": "#/$defs/nonEmptyString" },
            "root_cause_contrast": { "$ref": "#/$defs/nonEmptyString" },
            "mode_boundary": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        "coverage_statuses": {
          "type": "object",
          "additionalProperties": false,
          "required": ["development_balanced", "partial_contrast", "detection_only"],
          "properties": {
            "development_balanced": { "$ref": "#/$defs/nonEmptyString" },
            "partial_contrast": { "$ref": "#/$defs/nonEmptyString" },
            "detection_only": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        "independence_rule": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "historical_cases",
        "synthetic_countercases",
        "historical_cases_with_reviewer_fixture",
        "scenario_visible_fixture_cases",
        "clusters",
        "clusters_with_historical_detection",
        "clusters_with_any_challenge",
        "high_frequency_clusters",
        "high_frequency_clusters_with_any_challenge",
        "high_frequency_clusters_with_permission_reversal",
        "evaluation_cases",
        "holdout_cases",
        "readiness",
        "blocking_reasons"
      ],
      "properties": {
        "historical_cases": { "type": "integer", "minimum": 0 },
        "synthetic_countercases": { "type": "integer", "minimum": 0 },
        "historical_cases_with_reviewer_fixture": { "type": "integer", "minimum": 0 },
        "scenario_visible_fixture_cases": { "type": "integer", "minimum": 0 },
        "clusters": { "type": "integer", "minimum": 1 },
        "clusters_with_historical_detection": { "type": "integer", "minimum": 0 },
        "clusters_with_any_challenge": { "type": "integer", "minimum": 0 },
        "high_frequency_clusters": { "type": "integer", "minimum": 0 },
        "high_frequency_clusters_with_any_challenge": { "type": "integer", "minimum": 0 },
        "high_frequency_clusters_with_permission_reversal": { "type": "integer", "minimum": 0 },
        "evaluation_cases": { "type": "integer", "minimum": 0 },
        "holdout_cases": { "type": "integer", "minimum": 0 },
        "readiness": { "enum": ["ready", "conditional", "blocked"] },
        "blocking_reasons": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "contrast_type", "expected_delta"],
      "properties": {
        "case_id": { "$ref": "#/$defs/caseId" },
        "contrast_type": { "enum": ["permission_reversal", "root_cause_contrast", "mode_boundary"] },
        "expected_delta": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "counterCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "surface_pattern", "conclusion_changing_evidence", "expected_gate_delta"],
      "properties": {
        "candidate_id": { "type": "string", "pattern": "^CCAND-[A-Z0-9-]+-[0-9]{3}$" },
        "surface_pattern": { "$ref": "#/$defs/nonEmptyString" },
        "conclusion_changing_evidence": { "$ref": "#/$defs/nonEmptyString" },
        "expected_gate_delta": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster_id",
        "title",
        "description",
        "primary_reason_codes",
        "historical_case_ids",
        "challenge_cases",
        "corpus_frequency",
        "coverage_status",
        "gaps"
      ],
      "properties": {
        "cluster_id": { "type": "string", "pattern": "^CLU-[0-9]{2}$" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "primary_reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/reasonCode" }
        },
        "historical_case_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/caseId" }
        },
        "challenge_cases": {
          "type": "array",
          "items": { "$ref": "#/$defs/challenge" }
        },
        "corpus_frequency": { "enum": ["high", "medium", "low"] },
        "coverage_status": { "enum": ["development_balanced", "partial_contrast", "detection_only"] },
        "gaps": { "$ref": "#/$defs/nonEmptyStrings" },
        "next_countercase_candidate": { "$ref": "#/$defs/counterCandidate" }
      }
    },
    "nextAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority", "action", "rationale"],
      "properties": {
        "priority": { "enum": ["P0", "P1", "P2"] },
        "action": { "$ref": "#/$defs/nonEmptyString" },
        "rationale": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
