{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.scientific-assurance.invalid/schema/tool-availability-gate-receipt-v0.1.schema.json",
  "title": "Tool availability gate receipt",
  "description": "Receipt confirming that the tool availability gate completed probe and model context injection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_kind",
    "valid",
    "report_id",
    "report_sha256",
    "available_count",
    "unavailable_count",
    "unprobed_count",
    "degraded_count",
    "context_block_sha256",
    "decisions",
    "checks",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0-draft" },
    "receipt_kind": { "const": "tool_availability_gate_receipt" },
    "valid": { "type": "boolean" },
    "report_id": { "type": "string", "pattern": "^TOOL-AVAIL-[A-Z0-9._-]+$" },
    "report_sha256": { "$ref": "#/$defs/sha256" },
    "available_count": { "type": "integer", "minimum": 0 },
    "unavailable_count": { "type": "integer", "minimum": 0 },
    "unprobed_count": { "type": "integer", "minimum": 0 },
    "degraded_count": { "type": "integer", "minimum": 0 },
    "context_block_sha256": { "$ref": "#/$defs/sha256" },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_decision",
        "context_injected",
        "model_must_not_guess"
      ],
      "properties": {
        "gate_decision": { "enum": ["allow", "defer", "block"] },
        "context_injected": { "type": "boolean" },
        "model_must_not_guess": { "const": true }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_declared_tools_probed",
        "unavailable_tools_listed",
        "no_capability_guessing_permitted",
        "mechanical_probe_only",
        "no_model_invoked",
        "no_network_requested"
      ],
      "properties": {
        "all_declared_tools_probed": { "type": "boolean" },
        "unavailable_tools_listed": { "type": "boolean" },
        "no_capability_guessing_permitted": { "const": true },
        "mechanical_probe_only": { "const": true },
        "no_model_invoked": { "const": true },
        "no_network_requested": { "type": "boolean" }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonempty" }
    }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
