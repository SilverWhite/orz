{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.fep-agent.invalid/schema/workspace-trust-receipt-v0.1.schema.json",
  "title": "Unified Workspace Trust Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_kind", "receipt_id",
    "conversation_id", "adapter_id", "created_at",
    "workspace", "trust_established", "trust_granted",
    "checks", "errors", "limitations"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0-draft" },
    "receipt_kind": { "const": "workspace_trust_receipt" },
    "receipt_id": { "type": "string", "pattern": "^WTR-[A-Z0-9._-]+$" },
    "conversation_id": { "type": "string" },
    "adapter_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_path", "aggregate_sha256", "file_count"],
      "properties": {
        "root_path": { "type": "string" },
        "aggregate_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "file_count": { "type": "integer", "minimum": 0 },
        "policy_sha256": { "type": "string" }
      }
    },
    "trust_established": { "type": "boolean" },
    "trust_granted": { "type": "boolean" },
    "checks": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "errors": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
