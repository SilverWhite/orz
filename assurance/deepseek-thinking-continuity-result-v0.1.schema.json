{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.fep-agent.invalid/schema/deepseek-thinking-continuity-result-v0.1.schema.json",
  "title": "DeepSeek Thinking Continuity Conformance Result v0.1",
  "description": "Result of a DeepSeek thinking + tool-call multi-turn continuity conformance probe (GAK-01).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_kind",
    "run_id",
    "created_at",
    "valid",
    "request_count",
    "retry_count",
    "provider",
    "endpoint",
    "model",
    "marker_matched",
    "response_content_recorded",
    "credential_value_recorded",
    "tool_call_count",
    "tool_completed_count",
    "continuity",
    "process",
    "usage",
    "controls",
    "artifact_leak_scan",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "result_kind": {
      "enum": [
        "deepseek-thinking-continuity-real",
        "deepseek-thinking-continuity-fake"
      ]
    },
    "run_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "valid": { "type": "boolean" },
    "request_count": { "type": "integer", "minimum": 1 },
    "retry_count": { "type": "integer", "minimum": 0 },
    "provider": { "const": "deepseek" },
    "endpoint": { "const": "https://api.deepseek.com/chat/completions" },
    "model": { "type": "string", "minLength": 1 },
    "marker_matched": { "type": "boolean" },
    "response_content_recorded": { "const": false },
    "credential_value_recorded": { "const": false },
    "tool_call_count": { "type": "integer", "minimum": 0 },
    "tool_completed_count": { "type": "integer", "minimum": 0 },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_reasoning_found_in_artifacts"
      ],
      "properties": {
        "raw_reasoning_found_in_artifacts": { "type": "boolean" },
        "first_request_has_reasoning": { "type": ["boolean", "null"] },
        "second_request_preserved_reasoning": { "type": ["boolean", "null"] },
        "provider_request_count": { "type": "integer", "minimum": 0 }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": true,
      "required": ["exit_code", "duration_ms"],
      "properties": {
        "exit_code": { "type": "integer" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "job_object_created": { "type": "boolean" },
        "job_object_assigned": { "type": "boolean" },
        "kill_on_close": { "type": "boolean" }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": true,
      "required": ["input_tokens", "output_tokens", "reasoning_tokens", "total_tokens"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "reasoning_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": true,
      "required": ["tools_enabled", "fake_provider"],
      "properties": {
        "tools_enabled": { "type": "boolean" },
        "fake_provider": { "type": "boolean" },
        "binary_locked": { "type": "boolean" },
        "workspace_restricted": { "type": "boolean" },
        "isolated_profile": { "type": "boolean" },
        "clean_environment": { "type": "boolean" },
        "debug_enabled": { "type": "boolean" },
        "memory_enabled": { "type": "boolean" },
        "subagents_enabled": { "type": "boolean" },
        "web_enabled": { "type": "boolean" },
        "sandbox": { "type": "string" }
      }
    },
    "artifact_leak_scan": {
      "type": "object",
      "additionalProperties": true,
      "required": ["complete", "actual_credential_read_for_scan", "hit_count"],
      "properties": {
        "complete": { "type": "boolean" },
        "actual_credential_read_for_scan": { "const": false },
        "hit_count": { "type": "integer", "minimum": 0 }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
