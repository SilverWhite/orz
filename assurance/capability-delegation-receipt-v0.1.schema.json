{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.fep-agent.invalid/schema/capability-delegation-receipt-v0.1.schema.json",
  "title": "Capability Delegation Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_kind",
    "receipt_id",
    "conversation_id",
    "parent_envelope_id",
    "created_at",
    "subject",
    "requested",
    "decision",
    "integrity"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0-draft" },
    "receipt_kind": { "const": "capability_delegation" },
    "receipt_id": { "type": "string", "pattern": "^CDR-[A-F0-9]+$" },
    "conversation_id": { "type": "string", "pattern": "^CONV-[A-Z0-9._-]+$" },
    "parent_envelope_id": { "type": "string", "pattern": "^ENV-[A-Z0-9._-]+$" },
    "created_at": { "type": "string", "format": "date-time" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "subject_id"],
      "properties": {
        "kind": { "enum": ["child_process", "child_agent", "remote_mcp"] },
        "subject_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" }
      }
    },
    "requested": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "ttl_seconds"],
      "properties": {
        "allowed": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/capability" }
        },
        "ttl_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "child_envelope_id",
        "child_envelope_sha256",
        "effective_allowed",
        "effective_denied",
        "reason_codes"
      ],
      "properties": {
        "outcome": { "enum": ["delegated", "denied"] },
        "child_envelope_id": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^ENV-[A-Z0-9._-]+$" }
          ]
        },
        "child_envelope_sha256": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
        },
        "effective_allowed": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/capability" }
        },
        "effective_denied": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/capability" }
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9._-]+$" }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "key_id",
        "signature_algorithm",
        "signed_payload_sha256",
        "signature"
      ],
      "properties": {
        "canonicalization": { "const": "RFC8785" },
        "key_id": { "type": "string", "pattern": "^KEY-[A-Z0-9._-]+$" },
        "signature_algorithm": { "const": "hmac-sha256" },
        "signed_payload_sha256": { "$ref": "#/$defs/sha256" },
        "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "properties": { "outcome": { "const": "delegated" } },
            "required": ["outcome"]
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "properties": {
              "child_envelope_id": { "type": "string" },
              "child_envelope_sha256": { "type": "string" }
            }
          }
        }
      },
      "else": {
        "properties": {
          "decision": {
            "properties": {
              "child_envelope_id": { "type": "null" },
              "child_envelope_sha256": { "type": "null" },
              "effective_allowed": { "maxItems": 0 }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]+$"
    }
  }
}
