{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.scientific-assurance.invalid/schema/orientation-stagnation-terminal-v0.1.schema.json",
  "title": "Orientation runtime journal — terminal event payload (orientation track)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "stagnation_decision",
    "formal_runner_claimed",
    "restart_packet_retains_runaway_suffix"
  ],
  "properties": {
    "status": { "type": "string", "enum": ["completed", "invalidated"] },
    "stagnation_decision": {
      "type": "string",
      "enum": ["continue", "restart_requested", "handoff_required"]
    },
    "formal_runner_claimed": { "const": false },
    "restart_packet_retains_runaway_suffix": { "const": false }
  }
}
