{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.scientific-assurance.invalid/schema/orientation-checkpoint-verification-v0.1.schema.json",
  "title": "Orientation checkpoint verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_kind",
    "valid",
    "checkpoint_id",
    "checkpoint_sha256",
    "response_sha256",
    "allowed_fields_observed",
    "forbidden_fields_observed",
    "unexpected_fields_observed",
    "checks"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0-draft" },
    "receipt_kind": { "const": "orientation_checkpoint_verification" },
    "valid": { "type": "boolean" },
    "checkpoint_id": { "type": "string", "pattern": "^ORIENT-[A-Z0-9._-]+-[0-9]{4}$" },
    "checkpoint_sha256": { "$ref": "#/$defs/sha256" },
    "response_sha256": { "$ref": "#/$defs/sha256" },
    "allowed_fields_observed": {
      "type": "array",
      "items": {
        "enum": [
          "orientation_summary",
          "current_task_position",
          "next_output_target"
        ]
      },
      "uniqueItems": true
    },
    "forbidden_fields_observed": {
      "type": "array",
      "items": {
        "enum": [
          "counterexample_candidate",
          "claim_disposition",
          "claim_promotion",
          "negative_fixture_candidate"
        ]
      },
      "uniqueItems": true
    },
    "unexpected_fields_observed": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "neutral_orientation_only",
        "no_counterexample_candidate",
        "no_claim_disposition",
        "no_claim_strength_effect"
      ],
      "properties": {
        "neutral_orientation_only": { "type": "boolean" },
        "no_counterexample_candidate": { "type": "boolean" },
        "no_claim_disposition": { "type": "boolean" },
        "no_claim_strength_effect": { "const": true }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
