{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.scientific-assurance.invalid/schema/canonical-cli-run-receipt-v0.1.schema.json",
  "title": "Canonical guarded CLI run receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_kind",
    "valid",
    "run_id",
    "run_root",
    "run_manifest_sha256",
    "task_contract_sha256",
    "source_ledger_sha256",
    "source_gate_receipt_sha256",
    "instruction_provenance_gate_context_sha256",
    "instruction_provenance_gate_receipt_sha256",
    "tool_availability_report_sha256",
    "tool_availability_gate_receipt_sha256",
    "orientation_checkpoint_sha256",
    "answer_packet_sha256",
    "journal_sha256",
    "event_count",
    "terminal_event",
    "event_types",
    "checks",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0-draft" },
    "receipt_kind": { "const": "canonical_guarded_cli_run_receipt" },
    "valid": { "type": "boolean" },
    "run_id": { "type": "string", "pattern": "^RUN-[A-Z0-9._-]+$" },
    "run_root": { "type": "string", "minLength": 1 },
    "run_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "task_contract_sha256": { "$ref": "#/$defs/sha256" },
    "source_ledger_sha256": { "$ref": "#/$defs/sha256" },
    "source_gate_receipt_sha256": { "$ref": "#/$defs/sha256" },
    "instruction_provenance_gate_context_sha256": { "$ref": "#/$defs/sha256" },
    "instruction_provenance_gate_receipt_sha256": { "$ref": "#/$defs/sha256" },
    "tool_availability_report_sha256": { "$ref": "#/$defs/sha256" },
    "tool_availability_gate_receipt_sha256": { "$ref": "#/$defs/sha256" },
    "orientation_checkpoint_sha256": { "$ref": "#/$defs/sha256" },
    "answer_packet_sha256": { "$ref": "#/$defs/sha256" },
    "journal_sha256": { "$ref": "#/$defs/sha256" },
    "event_count": { "type": "integer", "minimum": 1 },
    "terminal_event": { "enum": ["run_finished", "run_failed", "run_cancelled", "run_invalidated"] },
    "event_types": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_valid",
        "task_contract_valid",
        "source_gate_recomputed",
        "gate_before_model_request",
        "instruction_gate_before_model",
        "tool_availability_gate_before_model",
        "orientation_checkpoint_before_model",
        "answer_packet_valid",
        "answer_binds_source_gate",
        "answer_binds_task_contract",
        "journal_hash_chain_valid",
        "terminal_exactly_once"
      ],
      "properties": {
        "manifest_valid": { "type": "boolean" },
        "task_contract_valid": { "type": "boolean" },
        "source_gate_recomputed": { "type": "boolean" },
        "gate_before_model_request": { "type": "boolean" },
        "instruction_gate_before_model": { "type": "boolean" },
        "tool_availability_gate_before_model": { "type": "boolean" },
        "orientation_checkpoint_before_model": { "type": "boolean" },
        "answer_packet_valid": { "type": "boolean" },
        "answer_binds_source_gate": { "type": "boolean" },
        "answer_binds_task_contract": { "type": "boolean" },
        "journal_hash_chain_valid": { "type": "boolean" },
        "terminal_exactly_once": { "type": "boolean" },
        "fake_adapter_no_network": { "type": "boolean" },
        "real_network_used": { "type": "boolean" }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
