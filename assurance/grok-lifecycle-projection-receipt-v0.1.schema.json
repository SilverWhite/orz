{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.scientific-assurance.invalid/schema/grok-lifecycle-projection-receipt-v0.1.schema.json",
  "title": "Grok workflow/subagent lifecycle projection receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_kind",
    "projection_id",
    "valid",
    "decision",
    "observed_at",
    "task_id",
    "source_global_progress_input_sha256",
    "projected_global_progress_input_sha256",
    "source_event_count",
    "projected_gps_event_count",
    "source_event_type_counts",
    "gps_journal_events",
    "orientation_context_block",
    "checks",
    "errors",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0-draft" },
    "receipt_kind": { "const": "grok_lifecycle_projection_receipt" },
    "projection_id": { "type": "string", "pattern": "^GROK-LIFE-[A-F0-9]{16}$" },
    "valid": { "type": "boolean" },
    "decision": { "type": "string", "enum": ["allow", "block"] },
    "observed_at": { "type": "string", "format": "date-time" },
    "task_id": { "$ref": "#/$defs/id" },
    "source_global_progress_input_sha256": { "$ref": "#/$defs/sha256" },
    "projected_global_progress_input_sha256": { "$ref": "#/$defs/sha256" },
    "source_event_count": { "type": "integer", "minimum": 0 },
    "projected_gps_event_count": { "type": "integer", "minimum": 0 },
    "source_event_type_counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "gps_journal_events": {
      "type": "array",
      "items": { "$ref": "#/$defs/journalEvent" }
    },
    "orientation_context_block": {
      "type": "string",
      "pattern": "^\\[GROK_LIFECYCLE_CONTEXT v0\\.1\\]"
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_events_metadata_only",
        "source_event_types_supported",
        "gps_events_schema_valid",
        "gps_step_bindings_valid",
        "global_progress_input_schema_valid",
        "orientation_context_neutral",
        "no_model_invoked",
        "no_network_requested",
        "no_claim_promotion",
        "prompt_tool_promotion_blocked"
      ],
      "properties": {
        "source_events_metadata_only": { "type": "boolean" },
        "source_event_types_supported": { "type": "boolean" },
        "gps_events_schema_valid": { "type": "boolean" },
        "gps_step_bindings_valid": { "type": "boolean" },
        "global_progress_input_schema_valid": { "type": "boolean" },
        "orientation_context_neutral": { "type": "boolean" },
        "no_model_invoked": { "type": "boolean" },
        "no_network_requested": { "type": "boolean" },
        "no_claim_promotion": { "type": "boolean" },
        "prompt_tool_promotion_blocked": { "type": "boolean" }
      }
    },
    "errors": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonempty" }
    },
    "limitations": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonempty" },
      "minItems": 1
    }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9._-]+$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "journalEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "event_id",
        "event_type",
        "step_id",
        "direction_id",
        "terminal_state",
        "write_effect",
        "verification_state"
      ],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 },
        "event_id": { "$ref": "#/$defs/id" },
        "event_type": {
          "enum": [
            "action_terminal",
            "artifact_registered",
            "verification_result",
            "plan_revised"
          ]
        },
        "step_id": {
          "oneOf": [
            { "$ref": "#/$defs/id" },
            { "type": "null" }
          ]
        },
        "direction_id": {
          "oneOf": [
            { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" },
            { "type": "null" }
          ]
        },
        "terminal_state": {
          "enum": ["succeeded", "failed", "cancelled", "unknown", null]
        },
        "write_effect": { "type": "boolean" },
        "verification_state": {
          "enum": ["pass", "warn", "fail", "stale", "unknown", null]
        }
      }
    }
  }
}
