{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.scientific-assurance.invalid/schema/diagnostic-coverage-check-verification-v0.1.schema.json",
  "title": "Diagnostic Coverage Check Verification",
  "description": "Verification receipt for a diagnostic coverage check response. Validates that the response is neutral (no counterexample or claim fields) and that no/uncertain responses propose at most one minimal next diagnostic action.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_kind",
    "valid",
    "checkpoint_id",
    "checkpoint_sha256",
    "response_sha256",
    "response_decision",
    "allowed_fields_observed",
    "forbidden_fields_observed",
    "unexpected_fields_observed",
    "checks"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0-draft" },
    "receipt_kind": { "const": "diagnostic_coverage_check_verification" },
    "valid": { "type": "boolean" },
    "checkpoint_id": {
      "type": "string",
      "pattern": "^DIAG-COV-[A-Z0-9._-]+-[0-9]+$"
    },
    "checkpoint_sha256": { "$ref": "#/$defs/sha256" },
    "response_sha256": { "$ref": "#/$defs/sha256" },
    "response_decision": {
      "enum": ["yes", "no", "uncertain"]
    },
    "allowed_fields_observed": {
      "type": "array",
      "items": {
        "enum": [
          "decision",
          "covered_diagnostic_surfaces",
          "missing_diagnostic_surfaces",
          "next_step"
        ]
      },
      "uniqueItems": true
    },
    "forbidden_fields_observed": {
      "type": "array",
      "items": {
        "enum": [
          "counterexample_candidate",
          "claim_disposition",
          "claim_promotion",
          "root_cause_certain",
          "global_review_requested"
        ]
      },
      "uniqueItems": true
    },
    "unexpected_fields_observed": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "next_step_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "neutral_diagnostic_only",
        "no_counterexample_candidate",
        "no_claim_disposition",
        "no_claim_strength_effect",
        "no_global_review",
        "next_step_bounded"
      ],
      "properties": {
        "neutral_diagnostic_only": { "type": "boolean" },
        "no_counterexample_candidate": { "type": "boolean" },
        "no_claim_disposition": { "type": "boolean" },
        "no_claim_strength_effect": { "const": true },
        "no_global_review": { "type": "boolean" },
        "next_step_bounded": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
