{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lif.local/schemas/grok-runtime-receipt-v0.1.schema.json",
  "title": "Grok Runtime Adapter Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_kind",
    "run_id",
    "created_at",
    "valid",
    "adapter",
    "request",
    "binary",
    "workspace_trust",
    "execution",
    "containment",
    "artifacts",
    "checks",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "receipt_kind": { "const": "grok_runtime_adapter_receipt" },
    "run_id": { "type": "string", "pattern": "^RUN-[A-Z0-9._-]+$" },
    "created_at": { "type": "string", "format": "date-time" },
    "valid": { "type": "boolean" },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "adapter_version", "runtime_owner"],
      "properties": {
        "adapter_id": { "const": "grok-runtime-adapter" },
        "adapter_version": { "const": "0.1.0" },
        "runtime_owner": { "const": "grok" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "workspace_path", "run_root"],
      "properties": {
        "mode": { "enum": ["version_smoke"] },
        "workspace_path": { "type": "string", "minLength": 1 },
        "run_root": { "type": "string", "minLength": 1 }
      }
    },
    "binary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inspection_path", "binary_path", "version_output", "sha256", "valid"],
      "properties": {
        "inspection_path": { "type": "string", "minLength": 1 },
        "binary_path": { "type": "string", "minLength": 1 },
        "version_output": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "valid": { "type": "boolean" }
      }
    },
    "workspace_trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_path", "valid", "trust_granted", "aggregate_sha256"],
      "properties": {
        "receipt_path": { "type": "string", "minLength": 1 },
        "valid": { "type": "boolean" },
        "trust_granted": { "type": "boolean" },
        "aggregate_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_kind",
        "pid",
        "exit_code",
        "timeout_seconds",
        "stdout_path",
        "stderr_path",
        "stdout_sha256",
        "stderr_sha256"
      ],
      "properties": {
        "command_kind": { "const": "grok_version" },
        "pid": { "type": "integer", "minimum": 1 },
        "exit_code": { "type": ["integer", "null"] },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "stdout_path": { "type": "string", "minLength": 1 },
        "stderr_path": { "type": "string", "minLength": 1 },
        "stdout_sha256": { "$ref": "#/$defs/sha256" },
        "stderr_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "containment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "no_residue_required",
        "no_residue_observed",
        "root_process_exited",
        "external_cleanup_required",
        "residue_scan_scope"
      ],
      "properties": {
        "no_residue_required": { "const": true },
        "no_residue_observed": { "type": "boolean" },
        "root_process_exited": { "type": "boolean" },
        "external_cleanup_required": { "type": "boolean" },
        "residue_scan_scope": { "enum": ["root_process_only"] }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_path", "events_path"],
      "properties": {
        "receipt_path": { "type": "string", "minLength": 1 },
        "events_path": { "type": "string", "minLength": 1 }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": { "type": "boolean" },
      "minProperties": 1
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
