{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lif.local/schemas/grok-runtime-receipt-v0.1.schema.json",
  "title": "Grok Runtime Adapter Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_kind",
    "run_id",
    "created_at",
    "valid",
    "adapter",
    "request",
    "binary",
    "workspace_trust",
    "retrieval",
    "execution",
    "containment",
    "artifacts",
    "checks",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "receipt_kind": { "const": "grok_runtime_adapter_receipt" },
    "run_id": { "type": "string", "pattern": "^RUN-[A-Z0-9._-]+$" },
    "created_at": { "type": "string", "format": "date-time" },
    "valid": { "type": "boolean" },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "adapter_version", "runtime_owner"],
      "properties": {
        "adapter_id": { "const": "grok-runtime-adapter" },
        "adapter_version": { "const": "0.1.0" },
        "runtime_owner": { "const": "grok" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "retrieval_mode", "retrieval_mode_explicit", "workspace_path", "run_root"],
      "properties": {
        "mode": { "enum": ["version_smoke", "prompt_smoke", "acp_smoke"] },
        "retrieval_mode": { "$ref": "#/$defs/retrieval_mode" },
        "retrieval_mode_explicit": { "type": "boolean" },
        "workspace_path": { "type": "string", "minLength": 1 },
        "run_root": { "type": "string", "minLength": 1 },
        "fake_provider": { "type": "boolean" },
        "disable_builtin_tools": { "type": "boolean" }
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "selected_explicitly",
        "applies_to",
        "active_for_current_mode",
        "runtime_tool_retrieval_allowed",
        "assurance_receipts_required",
        "valid_modes"
      ],
      "properties": {
        "mode": { "$ref": "#/$defs/retrieval_mode" },
        "selected_explicitly": { "type": "boolean" },
        "applies_to": { "const": "prompt_tool_runs" },
        "active_for_current_mode": { "type": "boolean" },
        "runtime_tool_retrieval_allowed": { "type": "boolean" },
        "assurance_receipts_required": { "type": "boolean" },
        "valid_modes": {
          "type": "array",
          "prefixItems": [
            { "const": "local_browser" },
            { "const": "framework_fallback" },
            { "const": "off" }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "binary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inspection_path", "binary_path", "version_output", "sha256", "valid"],
      "properties": {
        "inspection_path": { "type": "string", "minLength": 1 },
        "binary_path": { "type": "string", "minLength": 1 },
        "version_output": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "valid": { "type": "boolean" }
      }
    },
    "workspace_trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_path", "valid", "trust_granted", "aggregate_sha256"],
      "properties": {
        "receipt_path": { "type": "string", "minLength": 1 },
        "valid": { "type": "boolean" },
        "trust_granted": { "type": "boolean" },
        "aggregate_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_kind",
        "pid",
        "exit_code",
        "timeout_seconds",
        "stdout_path",
        "stderr_path",
        "stdout_sha256",
        "stderr_sha256"
      ],
      "properties": {
        "command_kind": { "enum": ["grok_version", "grok_prompt", "grok_acp"] },
        "pid": { "type": "integer", "minimum": 1 },
        "exit_code": { "type": ["integer", "null"] },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "stdout_path": { "type": "string", "minLength": 1 },
        "stderr_path": { "type": "string", "minLength": 1 },
        "stdout_sha256": { "$ref": "#/$defs/sha256" },
        "stderr_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "prompt": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prompt_sha256", "prompt_bytes", "model_id",
            "max_turns", "response_summary", "response_sha256",
            "response_finish_reason", "response_token_count", "output_format"
          ],
          "properties": {
            "prompt_sha256": { "$ref": "#/$defs/sha256" },
            "prompt_bytes": { "type": "integer", "minimum": 1 },
            "model_id": { "type": "string", "minLength": 1 },
            "max_turns": { "type": "integer", "minimum": 1 },
            "response_summary": { "type": "string" },
            "response_sha256": { "$ref": "#/$defs/sha256" },
            "response_finish_reason": { "type": "string" },
            "response_token_count": { "type": "integer", "minimum": 0 },
            "output_format": { "enum": ["streaming_json", "acp_json_rpc"] }
          }
        }
      ]
    },
    "acp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "session_id_hash",
        "tool_call_count",
        "permission_requests_count",
        "permission_outcomes",
        "turn_count",
        "stop_reason",
        "event_count",
        "prompt_count"
      ],
      "properties": {
        "protocol_version": { "type": "integer", "minimum": 0 },
        "session_id_hash": { "$ref": "#/$defs/sha256" },
        "tool_call_count": { "type": "integer", "minimum": 0 },
        "permission_requests_count": { "type": "integer", "minimum": 0 },
        "permission_outcomes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "turn_count": { "type": "integer", "minimum": 0 },
        "stop_reason": { "type": "string" },
        "event_count": { "type": "integer", "minimum": 0 },
        "prompt_count": { "type": "integer", "minimum": 0 }
      }
    },
    "fake_provider": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "ready_path",
            "result_path",
            "config_path",
            "host",
            "port",
            "real_model_invoked"
          ],
          "properties": {
            "enabled": { "const": true },
            "ready_path": { "type": "string", "minLength": 1 },
            "result_path": { "type": "string", "minLength": 1 },
            "config_path": { "type": "string", "minLength": 1 },
            "host": { "const": "127.0.0.1" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "real_model_invoked": { "const": false }
          }
        }
      ]
    },
    "containment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "no_residue_required",
        "no_residue_observed",
        "root_process_exited",
        "external_cleanup_required",
        "residue_scan_scope"
      ],
      "properties": {
        "no_residue_required": { "const": true },
        "no_residue_observed": { "type": "boolean" },
        "root_process_exited": { "type": "boolean" },
        "external_cleanup_required": { "type": "boolean" },
        "residue_scan_scope": {
          "enum": ["root_process_only", "job_object_contained", "full_tree"]
        },
        "job_object_created": { "type": "boolean" },
        "job_object_assigned": { "type": "boolean" },
        "containment_provider": {
          "enum": ["none", "adapter_job_object", "grok_owned"]
        },
        "containment_available": { "type": "boolean" }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_path", "events_path"],
      "properties": {
        "receipt_path": { "type": "string", "minLength": 1 },
        "events_path": { "type": "string", "minLength": 1 },
        "acp_transcript_path": { "type": "string", "minLength": 1 },
        "stderr_path": { "type": "string", "minLength": 1 },
        "binary_inspection_path": { "type": "string", "minLength": 1 },
        "workspace_trust_path": { "type": "string", "minLength": 1 },
        "permission_records_path": { "type": "string", "minLength": 1 },
        "fake_provider_ready_path": { "type": "string" },
        "fake_provider_result_path": { "type": "string" }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": { "type": "boolean" },
      "minProperties": 1
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "retrieval_mode": { "enum": ["local_browser", "framework_fallback", "off"] },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
