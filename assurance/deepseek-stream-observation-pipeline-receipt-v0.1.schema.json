{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.scientific-assurance.invalid/schema/deepseek-stream-observation-pipeline-receipt-v0.1.schema.json",
  "title": "DeepSeek stream observation pipeline receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_kind",
    "valid",
    "source_fixture",
    "artifacts",
    "decisions",
    "checks",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0-draft" },
    "receipt_kind": { "const": "deepseek_stream_observation_pipeline_receipt" },
    "valid": { "const": true },
    "source_fixture": { "$ref": "#/$defs/artifact" },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner_public_output_extraction",
        "orientation_stagnation_integration",
        "orientation_stagnation_journal"
      ],
      "properties": {
        "runner_public_output_extraction": { "$ref": "#/$defs/receipt_artifact" },
        "orientation_stagnation_integration": { "$ref": "#/$defs/receipt_artifact" },
        "orientation_stagnation_journal": { "$ref": "#/$defs/receipt_artifact" }
      }
    },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_output_count",
        "private_hidden_excluded_count",
        "stagnation_decision",
        "stagnation_action",
        "terminal_event_type"
      ],
      "properties": {
        "public_output_count": { "type": "integer", "minimum": 0 },
        "private_hidden_excluded_count": { "type": "integer", "minimum": 0 },
        "stagnation_decision": { "enum": ["continue", "restart_requested", "handoff_required"] },
        "stagnation_action": { "type": "string", "minLength": 1 },
        "terminal_event_type": { "enum": ["run_finished", "run_invalidated"] }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_stream_shape",
        "real_stream_captured",
        "model_invoked",
        "network_requested",
        "stream_sequence_contiguous",
        "private_reasoning_text_recorded",
        "hidden_chain_of_thought_saved",
        "public_output_only_for_restart",
        "orientation_counterexample_disabled"
      ],
      "properties": {
        "provider_stream_shape": { "const": "deepseek-chat-completions-stream" },
        "real_stream_captured": { "const": false },
        "model_invoked": { "const": false },
        "network_requested": { "const": false },
        "stream_sequence_contiguous": { "const": true },
        "private_reasoning_text_recorded": { "const": false },
        "hidden_chain_of_thought_saved": { "const": false },
        "public_output_only_for_restart": { "const": true },
        "orientation_counterexample_disabled": { "const": true }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "receipt_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "receipt_sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "receipt_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
