{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.fep-agent.invalid/schema/docker-sandbox-profile-v0.1.schema.json",
  "title": "Pinned Docker Strict Sandbox Profile v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_kind",
    "profile_id",
    "image",
    "identity",
    "filesystem",
    "network",
    "capabilities",
    "resources",
    "lifecycle"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0-draft" },
    "profile_kind": { "const": "docker_strict_sandbox_profile" },
    "profile_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "digest", "pull_policy"],
      "properties": {
        "reference": {
          "type": "string",
          "pattern": "^[^\\s@]+@sha256:[a-f0-9]{64}$"
        },
        "digest": { "$ref": "#/$defs/sha256" },
        "pull_policy": { "const": "never" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user"],
      "properties": {
        "user": { "type": "string", "pattern": "^[1-9][0-9]*:[1-9][0-9]*$" }
      }
    },
    "filesystem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_only_rootfs",
        "workspace_target",
        "workspace_mode",
        "workspace_source_policy",
        "tmpfs",
        "forbidden_host_mounts"
      ],
      "properties": {
        "read_only_rootfs": { "const": true },
        "workspace_target": { "const": "/workspace" },
        "workspace_mode": { "const": "read_write" },
        "workspace_source_policy": { "const": "explicit_canonical_path" },
        "tmpfs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "contains": {
            "type": "object",
            "properties": { "target": { "const": "/tmp" } },
            "required": ["target"]
          },
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "options"],
            "properties": {
              "target": { "type": "string", "pattern": "^/[A-Za-z0-9._/-]+$" },
              "options": { "type": "string", "minLength": 1 }
            }
          }
        },
        "forbidden_host_mounts": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,63}$"
          },
          "allOf": [
            { "contains": { "const": "host_home" } },
            { "contains": { "const": "docker_socket" } },
            { "contains": { "const": "credential_store" } },
            { "contains": { "const": "ssh_agent" } }
          ]
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": { "mode": { "const": "none" } }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["drop", "add", "no_new_privileges"],
      "properties": {
        "drop": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "const": "ALL" }
        },
        "add": { "type": "array", "maxItems": 0 },
        "no_new_privileges": { "const": true }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory_bytes",
        "nano_cpus",
        "pids_limit",
        "wall_time_seconds"
      ],
      "properties": {
        "memory_bytes": { "type": "integer", "minimum": 1 },
        "nano_cpus": { "type": "integer", "minimum": 1 },
        "pids_limit": { "type": "integer", "minimum": 1 },
        "wall_time_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cleanup_required", "reuse_container"],
      "properties": {
        "cleanup_required": { "const": true },
        "reuse_container": { "const": false }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
