{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.scientific-assurance.invalid/schema/orientation-stagnation-run-started-v0.1.schema.json",
  "title": "Orientation runtime journal — run-started event payload (orientation track)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "step_index"
  ],
  "properties": {
    "task_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9._-]*$" },
    "step_index": { "type": "integer", "minimum": 0 }
  }
}
