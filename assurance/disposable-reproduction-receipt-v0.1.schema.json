{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.scientific-assurance.invalid/schema/disposable-reproduction-receipt-v0.1.schema.json",
  "title": "General science disposable reproduction receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_kind",
    "reproduction_id",
    "manifest_sha256",
    "source_bundle_sha256",
    "source_snapshot_unchanged",
    "output_root",
    "outputs",
    "safety",
    "evidence_boundary",
    "valid",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft"
    },
    "receipt_kind": {
      "const": "general_science_disposable_reproduction_receipt"
    },
    "reproduction_id": {
      "$ref": "#/$defs/id"
    },
    "manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_bundle_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_snapshot_unchanged": {
      "const": true
    },
    "output_root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "output_id",
          "path",
          "bytes",
          "sha256",
          "original_artifact_id",
          "original_artifact_sha256",
          "artifact_schema_id",
          "value_checks"
        ],
        "properties": {
          "output_id": {
            "$ref": "#/$defs/id"
          },
          "path": {
            "$ref": "#/$defs/path"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "original_artifact_id": {
            "$ref": "#/$defs/id"
          },
          "original_artifact_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "artifact_schema_id": {
            "const": "GSAS_NUMERICAL_SINGLE_RUN_0_1"
          },
          "value_checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pointer",
                "matches_original"
              ],
              "properties": {
                "pointer": {
                  "$ref": "#/$defs/json_pointer"
                },
                "matches_original": {
                  "const": true
                }
              }
            }
          }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_write_attempted",
        "model_invoked",
        "network_requested",
        "child_process_spawned",
        "external_code_executed"
      ],
      "properties": {
        "source_write_attempted": {
          "const": false
        },
        "model_invoked": {
          "const": false
        },
        "network_requested": {
          "const": false
        },
        "child_process_spawned": {
          "const": false
        },
        "external_code_executed": {
          "const": false
        }
      }
    },
    "evidence_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independence_effect",
        "claim_strength_effect"
      ],
      "properties": {
        "independence_effect": {
          "const": "no_new_independent_evidence"
        },
        "claim_strength_effect": {
          "const": "no_claim_promotion"
        }
      }
    },
    "valid": {
      "const": true
    },
    "limitations": {
      "$ref": "#/$defs/nonempty_strings"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{2,95}$"
    },
    "json_pointer": {
      "type": "string",
      "pattern": "^(?:/(?:[^~/]|~[01])*)*$",
      "maxLength": 1024
    },
    "nonempty_strings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "not": {
        "pattern": "(^/|^[A-Za-z]:|\\\\|\\.\\.)"
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
