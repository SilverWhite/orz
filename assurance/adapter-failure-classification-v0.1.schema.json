{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.fep-agent.invalid/schema/adapter-failure-classification-v0.1.schema.json",
  "title": "Adapter Failure Classification v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "classification_kind",
    "classified_at",
    "category",
    "retryable",
    "description",
    "recovery_action",
    "diagnostic",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0-draft" },
    "classification_kind": { "const": "adapter_failure_classification" },
    "classified_at": { "type": "string", "format": "date-time" },
    "category": {
      "enum": [
        "network_timeout",
        "network_unreachable",
        "auth_failure",
        "rate_limited",
        "server_error",
        "content_filtered",
        "invalid_output",
        "model_unavailable",
        "context_length_exceeded",
        "unknown"
      ]
    },
    "retryable": { "type": "boolean" },
    "description": { "type": "string", "minLength": 1 },
    "recovery_action": { "type": "string", "minLength": 1 },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exception_type",
        "exception_message",
        "http_status",
        "timeout_detected",
        "connection_error_detected",
        "output_validation_failed"
      ],
      "properties": {
        "exception_type": { "type": ["string", "null"] },
        "exception_message": { "type": "string" },
        "http_status": { "type": ["integer", "null"] },
        "timeout_detected": { "type": "boolean" },
        "connection_error_detected": { "type": "boolean" },
        "output_validation_failed": { "type": "boolean" }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
