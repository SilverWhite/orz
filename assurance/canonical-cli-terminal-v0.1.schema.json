{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.scientific-assurance.invalid/schema/canonical-cli-terminal-v0.1.schema.json",
  "title": "Canonical guarded CLI terminal event payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "source_gate_decision",
    "answer_packet_sha256"
  ],
  "properties": {
    "status": { "enum": ["completed", "failed"] },
    "source_gate_decision": { "type": "string", "minLength": 1 },
    "answer_packet_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
