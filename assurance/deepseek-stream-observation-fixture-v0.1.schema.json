{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.scientific-assurance.invalid/schema/deepseek-stream-observation-fixture-v0.1.schema.json",
  "title": "DeepSeek stream observation fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_kind",
    "stream_id",
    "task_id",
    "task_contract_sha256",
    "step_index",
    "retry_count",
    "retry_budget",
    "thresholds",
    "progress_markers",
    "chunks"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0-draft" },
    "fixture_kind": { "const": "deepseek_stream_observation_fixture" },
    "stream_id": { "type": "string", "pattern": "^STREAM-[A-Z0-9._-]+$" },
    "task_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9._-]*$" },
    "task_contract_sha256": { "$ref": "#/$defs/sha256" },
    "step_index": { "type": "integer", "minimum": 0 },
    "retry_count": { "type": "integer", "minimum": 0 },
    "retry_budget": { "type": "integer", "minimum": 0 },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repeated_content_threshold", "ngram_repeat_threshold"],
      "properties": {
        "repeated_content_threshold": { "type": "integer", "minimum": 1 },
        "ngram_repeat_threshold": { "type": "integer", "minimum": 1 }
      }
    },
    "progress_markers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/chunk" }
    }
  },
  "$defs": {
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chunk_id", "sequence"],
      "properties": {
        "chunk_id": { "type": "string", "pattern": "^CHK-[A-Z0-9._-]+$" },
        "sequence": { "type": "integer", "minimum": 0 },
        "delta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "role": { "const": "assistant" },
            "content": { "type": "string", "minLength": 1 },
            "reasoning_content_sha256": { "$ref": "#/$defs/sha256" }
          },
          "minProperties": 1
        },
        "finish_reason": { "type": "string", "minLength": 1 },
        "usage": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "anyOf": [
        { "required": ["delta"] },
        { "required": ["finish_reason"] },
        { "required": ["usage"] }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
