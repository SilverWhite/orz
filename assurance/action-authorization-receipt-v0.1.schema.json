{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.fep-agent.invalid/schema/action-authorization-receipt-v0.1.schema.json",
  "title": "Kernel Action Authorization Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_kind",
    "receipt_id",
    "conversation_id",
    "envelope_id",
    "created_at",
    "provenance_receipt_sha256",
    "action",
    "permit_consumption_sha256",
    "decision",
    "integrity"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0-draft" },
    "receipt_kind": { "const": "kernel_action_authorization" },
    "receipt_id": { "type": "string", "pattern": "^AAR-[A-F0-9]+$" },
    "conversation_id": { "type": "string", "pattern": "^CONV-[A-Z0-9._-]+$" },
    "envelope_id": { "type": "string", "pattern": "^ENV-[A-Z0-9._-]+$" },
    "created_at": { "type": "string", "format": "date-time" },
    "provenance_receipt_sha256": { "$ref": "#/$defs/sha256" },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "action_type",
        "risk_class",
        "action_sha256",
        "target_sha256",
        "impact_scope_sha256",
        "requested_capabilities",
        "attempt"
      ],
      "properties": {
        "action_id": { "type": "string", "pattern": "^ACT-[A-Z0-9._-]+$" },
        "action_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
        },
        "risk_class": {
          "enum": ["normal", "sensitive", "external_side_effect"]
        },
        "action_sha256": { "$ref": "#/$defs/sha256" },
        "target_sha256": { "$ref": "#/$defs/sha256" },
        "impact_scope_sha256": { "$ref": "#/$defs/sha256" },
        "requested_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/capability" }
        },
        "attempt": { "type": "integer", "minimum": 1 },
        "idempotency_key": {
          "description": "Stable idempotency identifier. Required for sensitive/external_side_effect actions. Absence triggers ACT-IDEMPOTENCY-001.",
          "type": "string", "pattern": "^IDEM-[a-f0-9]{32,64}$"
        }
      }
    },
    "permit_consumption_sha256": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "authority_source",
        "model_assertion_ignored",
        "reason_codes"
      ],
      "properties": {
        "outcome": { "enum": ["allow", "deny"] },
        "authority_source": {
          "enum": ["envelope", "envelope_and_one_shot_permit", "none"]
        },
        "model_assertion_ignored": { "const": true },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9._-]+$" }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "key_id",
        "signature_algorithm",
        "signed_payload_sha256",
        "signature"
      ],
      "properties": {
        "canonicalization": { "const": "RFC8785" },
        "key_id": { "type": "string", "pattern": "^KEY-[A-Z0-9._-]+$" },
        "signature_algorithm": { "const": "hmac-sha256" },
        "signed_payload_sha256": { "$ref": "#/$defs/sha256" },
        "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]+$"
    }
  }
}
