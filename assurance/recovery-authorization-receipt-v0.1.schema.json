{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.fep-agent.invalid/schema/recovery-authorization-receipt-v0.1.schema.json",
  "title": "Recovery Authorization Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_kind",
    "receipt_id",
    "candidate_id",
    "conversation_id",
    "envelope_id",
    "created_at",
    "candidate_sha256",
    "binding",
    "permit_consumption_sha256",
    "decision",
    "integrity"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0-draft" },
    "receipt_kind": { "const": "recovery_authorization" },
    "receipt_id": { "type": "string", "pattern": "^RAR-[A-F0-9]+$" },
    "candidate_id": { "type": "string", "pattern": "^RCV-[A-F0-9]+$" },
    "conversation_id": { "type": "string", "pattern": "^CONV-[A-Z0-9._-]+$" },
    "envelope_id": { "type": "string", "pattern": "^ENV-[A-Z0-9._-]+$" },
    "created_at": { "type": "string", "format": "date-time" },
    "candidate_sha256": { "$ref": "#/$defs/sha256" },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_sha256",
        "target_workspace_sha256",
        "snapshot_sha256",
        "attempt"
      ],
      "properties": {
        "action_sha256": { "$ref": "#/$defs/sha256" },
        "target_workspace_sha256": { "$ref": "#/$defs/sha256" },
        "snapshot_sha256": { "$ref": "#/$defs/sha256" },
        "attempt": { "type": "integer", "minimum": 1 }
      }
    },
    "permit_consumption_sha256": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "authority_source",
        "restoration_performed",
        "reason_codes"
      ],
      "properties": {
        "outcome": { "enum": ["allow", "deny"] },
        "authority_source": {
          "enum": ["envelope_and_one_shot_permit", "none"]
        },
        "restoration_performed": { "const": false },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9._-]{1,127}$"
          }
        }
      }
    },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "key_id",
        "signature_algorithm",
        "signed_payload_sha256",
        "signature"
      ],
      "properties": {
        "canonicalization": { "const": "RFC8785" },
        "key_id": { "type": "string", "pattern": "^KEY-[A-Z0-9._-]+$" },
        "signature_algorithm": { "const": "hmac-sha256" },
        "signed_payload_sha256": { "$ref": "#/$defs/sha256" },
        "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
      }
    }
  }
}
