{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.scientific-assurance.invalid/schema/disposable-reproduction-run-proof-v0.1.schema.json",
  "title": "General science disposable reproduction run proof",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proof_kind",
    "reproduction_id",
    "manifest_sha256",
    "receipt_sha256",
    "verification_sha256",
    "code",
    "environment",
    "inputs",
    "outputs",
    "journal",
    "evidence_boundary",
    "valid"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft"
    },
    "proof_kind": {
      "const": "general_science_disposable_reproduction_run_proof"
    },
    "reproduction_id": {
      "$ref": "#/$defs/id"
    },
    "manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "verification_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "files"
      ],
      "properties": {
        "implementation": {
          "const": "explicit_euler_decay_replay_v0.1"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/file_digest"
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python_version",
        "python_implementation",
        "platform_system",
        "platform_release",
        "filesystem_encoding"
      ],
      "properties": {
        "python_version": {
          "$ref": "#/$defs/nonempty"
        },
        "python_implementation": {
          "$ref": "#/$defs/nonempty"
        },
        "platform_system": {
          "$ref": "#/$defs/nonempty"
        },
        "platform_release": {
          "$ref": "#/$defs/nonempty"
        },
        "filesystem_encoding": {
          "$ref": "#/$defs/nonempty"
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "role",
          "path",
          "sha256"
        ],
        "properties": {
          "record_id": {
            "$ref": "#/$defs/id"
          },
          "role": {
            "enum": [
              "source_bundle",
              "input_snapshot"
            ]
          },
          "path": {
            "$ref": "#/$defs/path"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "output_id",
          "path",
          "sha256",
          "original_artifact_id",
          "artifact_schema_id"
        ],
        "properties": {
          "output_id": {
            "$ref": "#/$defs/id"
          },
          "path": {
            "$ref": "#/$defs/path"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "original_artifact_id": {
            "$ref": "#/$defs/id"
          },
          "artifact_schema_id": {
            "const": "GSAS_NUMERICAL_SINGLE_RUN_0_1"
          }
        }
      }
    },
    "journal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "events"
      ],
      "properties": {
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canonicalization",
            "hash_chain",
            "event_count",
            "content_policy"
          ],
          "properties": {
            "canonicalization": {
              "const": "RFC8785"
            },
            "hash_chain": {
              "const": "sha256"
            },
            "event_count": {
              "const": 3
            },
            "content_policy": {
              "const": "metadata_only"
            }
          }
        },
        "events": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sequence",
              "event_type",
              "payload_sha256",
              "previous_event_sha256",
              "event_sha256"
            ],
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              },
              "event_type": {
                "enum": [
                  "run_preflight",
                  "run_started",
                  "run_finished"
                ]
              },
              "payload_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "previous_event_sha256": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/sha256"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "event_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      }
    },
    "evidence_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independence_effect",
        "claim_strength_effect",
        "runner_status"
      ],
      "properties": {
        "independence_effect": {
          "const": "no_new_independent_evidence"
        },
        "claim_strength_effect": {
          "const": "no_claim_promotion"
        },
        "runner_status": {
          "const": "development_fixture_only"
        }
      }
    },
    "valid": {
      "const": true
    }
  },
  "$defs": {
    "file_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{2,95}$"
    },
    "nonempty": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "not": {
        "pattern": "(^/|^[A-Za-z]:|\\\\|\\.\\.)"
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
