{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.scientific-assurance.invalid/schema/orientation-stagnation-integration-receipt-v0.1.schema.json",
  "title": "Orientation/stagnation integration receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_kind",
    "valid",
    "fixture_sha256",
    "task_id",
    "step_index",
    "output_root",
    "artifacts",
    "decisions",
    "checks",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0-draft" },
    "receipt_kind": { "const": "orientation_stagnation_integration_receipt" },
    "valid": { "const": true },
    "fixture_sha256": { "$ref": "#/$defs/sha256" },
    "task_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9._-]*$" },
    "step_index": { "type": "integer", "minimum": 0 },
    "output_root": { "$ref": "#/$defs/nonempty" },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orientation_checkpoint",
        "runtime_stagnation_guard_receipt"
      ],
      "properties": {
        "orientation_checkpoint": { "$ref": "#/$defs/artifact" },
        "runtime_stagnation_guard_receipt": { "$ref": "#/$defs/artifact" },
        "tool_availability_report": { "$ref": "#/$defs/artifact" },
        "tool_availability_gate_receipt": { "$ref": "#/$defs/artifact" },
        "tool_belief_stagnation_receipt": { "$ref": "#/$defs/artifact" }
      }
    },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stagnation_decision",
        "stagnation_action",
        "reason_codes"
      ],
      "properties": {
        "stagnation_decision": {
          "enum": ["continue", "restart_requested", "handoff_required"]
        },
        "stagnation_action": {
          "enum": ["none", "stop_and_restart", "stop_and_handoff"]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "enum": [
              "STAGNATION-CONSECUTIVE-REPEAT",
              "STAGNATION-NGRAM-REPEAT",
              "TOOL-BELIEF-UNAVAILABLE-TOOL-MENTIONED",
              "TOOL-BELIEF-CAPABILITY-GUESSING"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orientation_neutral_checkpoint",
        "orientation_counterexample_disabled",
        "orientation_claim_disposition_disabled",
        "orientation_no_claim_strength_effect",
        "mechanisms_decoupled",
        "stagnation_public_output_only",
        "hidden_chain_of_thought_saved",
        "runner_attached",
        "model_invoked",
        "network_requested",
        "counterexample_queue_invoked",
        "retry_budget_bounded",
        "tool_availability_gate_completed",
        "tool_belief_stagnation_completed"
      ],
      "properties": {
        "orientation_neutral_checkpoint": { "const": true },
        "orientation_counterexample_disabled": { "const": true },
        "orientation_claim_disposition_disabled": { "const": true },
        "orientation_no_claim_strength_effect": { "const": true },
        "mechanisms_decoupled": { "const": true },
        "stagnation_public_output_only": { "const": true },
        "hidden_chain_of_thought_saved": { "const": false },
        "runner_attached": { "const": false },
        "model_invoked": { "const": false },
        "network_requested": { "const": false },
        "counterexample_queue_invoked": { "const": false },
        "retry_budget_bounded": { "type": "boolean" },
        "tool_availability_gate_completed": { "type": "boolean" },
        "tool_belief_stagnation_completed": { "type": "boolean" }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonempty" }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/nonempty" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "nonempty": { "type": "string", "minLength": 1 },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
