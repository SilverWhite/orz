{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.scientific-assurance.invalid/schema/general-science-artifact-registry-v0.1.schema.json",
  "title": "General science artifact schema registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_kind",
    "registry_id",
    "artifact_schemas"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft"
    },
    "registry_kind": {
      "const": "general_science_artifact_schema_registry"
    },
    "registry_id": {
      "$ref": "#/$defs/id"
    },
    "artifact_schemas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_schema_id",
          "version",
          "artifact_kind",
          "media_type",
          "schema_name",
          "failure_decision",
          "reason_code"
        ],
        "properties": {
          "artifact_schema_id": {
            "$ref": "#/$defs/id"
          },
          "version": {
            "const": "0.1.0"
          },
          "artifact_kind": {
            "$ref": "#/$defs/artifact_kind"
          },
          "media_type": {
            "const": "application/json"
          },
          "schema_name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*\\.schema\\.json$"
          },
          "failure_decision": {
            "const": "block"
          },
          "reason_code": {
            "const": "ART-SCHEMA-001"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{2,95}$"
    },
    "artifact_kind": {
      "enum": [
        "numerical_result",
        "statistical_summary",
        "tabular_result",
        "other_json"
      ]
    }
  }
}
