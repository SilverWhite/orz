{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.fep-agent.invalid/schema/readonly-task-projection-receipt-v0.1.schema.json",
  "title": "P5 read-only complex task projection receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_kind",
    "receipt_id",
    "created_at",
    "projection_id",
    "bindings",
    "safety",
    "files",
    "result",
    "integrity"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0-draft" },
    "receipt_kind": { "const": "readonly_complex_task_projection_receipt" },
    "receipt_id": {
      "type": "string",
      "pattern": "^RTP-[A-Z0-9._-]+$"
    },
    "created_at": { "type": "string", "format": "date-time" },
    "projection_id": { "const": "P5-LIF-R211-READONLY-001" },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection_sha256",
        "source_root_path_sha256",
        "source_before_aggregate_sha256",
        "source_after_aggregate_sha256",
        "snapshot_aggregate_sha256"
      ],
      "properties": {
        "projection_sha256": { "$ref": "#/$defs/sha256" },
        "source_root_path_sha256": { "$ref": "#/$defs/sha256" },
        "source_before_aggregate_sha256": { "$ref": "#/$defs/sha256" },
        "source_after_aggregate_sha256": { "$ref": "#/$defs/sha256" },
        "snapshot_aggregate_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_opened_read_only",
        "source_write_attempted",
        "source_content_unchanged",
        "snapshot_is_untrusted_copy",
        "training_executed",
        "analysis_code_executed",
        "model_invoked",
        "network_requested",
        "docker_invoked",
        "child_process_spawned"
      ],
      "properties": {
        "source_opened_read_only": { "const": true },
        "source_write_attempted": { "const": false },
        "source_content_unchanged": { "const": true },
        "snapshot_is_untrusted_copy": { "const": true },
        "training_executed": { "const": false },
        "analysis_code_executed": { "const": false },
        "model_invoked": { "const": false },
        "network_requested": { "const": false },
        "docker_invoked": { "const": false },
        "child_process_spawned": { "const": false }
      }
    },
    "files": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relative_path",
          "role",
          "bytes",
          "source_before_sha256",
          "source_after_sha256",
          "snapshot_sha256",
          "content_match"
        ],
        "properties": {
          "relative_path": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 1 },
          "source_before_sha256": { "$ref": "#/$defs/sha256" },
          "source_after_sha256": { "$ref": "#/$defs/sha256" },
          "snapshot_sha256": { "$ref": "#/$defs/sha256" },
          "content_match": { "const": true }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "projected_file_count",
        "source_mutation_detected"
      ],
      "properties": {
        "outcome": { "const": "projected_readonly" },
        "projected_file_count": { "type": "integer", "minimum": 6 },
        "source_mutation_detected": { "const": false }
      }
    },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "key_id",
        "signature_algorithm",
        "signed_payload_sha256",
        "signature"
      ],
      "properties": {
        "canonicalization": { "const": "RFC8785" },
        "key_id": {
          "type": "string",
          "pattern": "^KEY-[A-Z0-9._-]+$"
        },
        "signature_algorithm": { "const": "hmac-sha256" },
        "signed_payload_sha256": { "$ref": "#/$defs/sha256" },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      }
    }
  }
}
