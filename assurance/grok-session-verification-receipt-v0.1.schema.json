{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.scientific-assurance.invalid/schema/grok-session-verification-receipt-v0.1.schema.json",
  "title": "Grok ACP session cross-verification receipt",
  "description": "Post-run cross-verification of events.jsonl (normalized runtime events) against acp_transcript.jsonl (raw ACP transcript) and the runtime receipt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_kind",
    "verification_id",
    "created_at",
    "run_id",
    "valid",
    "checks",
    "errors",
    "transcript_message_count",
    "event_count",
    "event_type_counts",
    "receipt_acp_block_sha256",
    "events_sha256",
    "transcript_sha256",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0-draft" },
    "receipt_kind": { "const": "grok_session_verification_receipt" },
    "verification_id": { "type": "string", "pattern": "^GSV-[A-F0-9]{16}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "run_id": { "$ref": "#/$defs/id" },
    "valid": { "type": "boolean" },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acp_lifecycle_complete",
        "session_id_consistent",
        "tool_call_count_match",
        "permission_count_match",
        "permission_outcomes_match",
        "transcript_has_expected_lifecycle",
        "event_hash_chain_valid"
      ],
      "properties": {
        "acp_lifecycle_complete": { "type": "boolean" },
        "session_id_consistent": { "type": "boolean" },
        "tool_call_count_match": { "type": "boolean" },
        "permission_count_match": { "type": "boolean" },
        "permission_outcomes_match": { "type": "boolean" },
        "transcript_has_expected_lifecycle": { "type": "boolean" },
        "event_hash_chain_valid": { "type": "boolean" }
      }
    },
    "errors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "transcript_message_count": { "type": "integer", "minimum": 0 },
    "event_count": { "type": "integer", "minimum": 0 },
    "event_type_counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "receipt_acp_block_sha256": { "$ref": "#/$defs/sha256" },
    "events_sha256": { "$ref": "#/$defs/sha256" },
    "transcript_sha256": { "$ref": "#/$defs/sha256" },
    "receipt_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
