{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.scientific-assurance.invalid/schema/general-science-numerical-single-run-result-v0.1.schema.json",
  "title": "General science deterministic single-run numerical result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_kind",
    "method",
    "equation",
    "initial_value",
    "final_time",
    "exact_final_value",
    "comparison_context",
    "run"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft"
    },
    "result_kind": {
      "const": "deterministic_time_step_run"
    },
    "method": {
      "$ref": "#/$defs/nonempty"
    },
    "equation": {
      "$ref": "#/$defs/nonempty"
    },
    "initial_value": {
      "type": "number"
    },
    "final_time": {
      "type": "number"
    },
    "exact_final_value": {
      "type": "number"
    },
    "comparison_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "protocol_id",
        "metric_id",
        "population_id",
        "unit",
        "comparison_family_id",
        "varied_dimension",
        "lineage",
        "condition"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/id"
        },
        "protocol_id": {
          "$ref": "#/$defs/id"
        },
        "metric_id": {
          "$ref": "#/$defs/id"
        },
        "population_id": {
          "$ref": "#/$defs/id"
        },
        "unit": {
          "$ref": "#/$defs/id"
        },
        "comparison_family_id": {
          "$ref": "#/$defs/id"
        },
        "varied_dimension": {
          "$ref": "#/$defs/id"
        },
        "lineage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "producer_action_id",
            "source_ids",
            "transformation_id"
          ],
          "properties": {
            "producer_action_id": {
              "$ref": "#/$defs/id"
            },
            "source_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "transformation_id": {
              "$ref": "#/$defs/id"
            }
          }
        },
        "condition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dimension",
            "value",
            "value_pointer"
          ],
          "properties": {
            "dimension": {
              "$ref": "#/$defs/id"
            },
            "value": {
              "type": [
                "string",
                "number",
                "integer",
                "boolean"
              ]
            },
            "value_pointer": {
              "type": "string",
              "pattern": "^(?:/(?:[^~/]|~[01])*)*$",
              "maxLength": 1024
            }
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_size",
        "step_count",
        "final_value",
        "final_absolute_error"
      ],
      "properties": {
        "step_size": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "step_count": {
          "type": "integer",
          "minimum": 1
        },
        "final_value": {
          "type": "number"
        },
        "final_absolute_error": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{2,95}$"
    },
    "nonempty": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  }
}
