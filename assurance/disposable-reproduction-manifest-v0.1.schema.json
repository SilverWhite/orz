{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.scientific-assurance.invalid/schema/disposable-reproduction-manifest-v0.1.schema.json",
  "title": "General science disposable reproduction manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reproduction_kind",
    "reproduction_id",
    "source_bundle",
    "input_snapshot",
    "allowed_action",
    "outputs",
    "safety",
    "evidence_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft"
    },
    "reproduction_kind": {
      "const": "general_science_disposable_reproduction"
    },
    "reproduction_id": {
      "$ref": "#/$defs/id"
    },
    "source_bundle": {
      "$ref": "#/$defs/file_record"
    },
    "input_snapshot": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/file_record"
      }
    },
    "allowed_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "source_action_id",
        "implementation",
        "parameters"
      ],
      "properties": {
        "action_id": {
          "$ref": "#/$defs/id"
        },
        "source_action_id": {
          "$ref": "#/$defs/id"
        },
        "implementation": {
          "const": "explicit_euler_decay_replay_v0.1"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "equation",
            "initial_value",
            "final_time",
            "exact_final_value"
          ],
          "properties": {
            "method": {
              "const": "explicit_euler"
            },
            "equation": {
              "const": "dy/dt=-y"
            },
            "initial_value": {
              "type": "number"
            },
            "final_time": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "exact_final_value": {
              "type": "number"
            }
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "output_id",
          "path",
          "original_artifact_id",
          "artifact_kind",
          "artifact_schema_id",
          "step_size",
          "value_pointers"
        ],
        "properties": {
          "output_id": {
            "$ref": "#/$defs/id"
          },
          "path": {
            "$ref": "#/$defs/path"
          },
          "original_artifact_id": {
            "$ref": "#/$defs/id"
          },
          "artifact_kind": {
            "const": "numerical_result"
          },
          "artifact_schema_id": {
            "const": "GSAS_NUMERICAL_SINGLE_RUN_0_1"
          },
          "step_size": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "value_pointers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/json_pointer"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_write_allowed",
        "model_invocation_allowed",
        "network_allowed",
        "child_process_allowed",
        "external_code_execution_allowed"
      ],
      "properties": {
        "source_write_allowed": {
          "const": false
        },
        "model_invocation_allowed": {
          "const": false
        },
        "network_allowed": {
          "const": false
        },
        "child_process_allowed": {
          "const": false
        },
        "external_code_execution_allowed": {
          "const": false
        }
      }
    },
    "evidence_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independence_effect",
        "claim_strength_effect",
        "limitations"
      ],
      "properties": {
        "independence_effect": {
          "const": "no_new_independent_evidence"
        },
        "claim_strength_effect": {
          "const": "no_claim_promotion"
        },
        "limitations": {
          "$ref": "#/$defs/nonempty_strings"
        }
      }
    }
  },
  "$defs": {
    "file_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "path",
        "sha256",
        "media_type"
      ],
      "properties": {
        "record_id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "media_type": {
          "enum": [
            "application/json",
            "text/markdown"
          ]
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{2,95}$"
    },
    "json_pointer": {
      "type": "string",
      "pattern": "^(?:/(?:[^~/]|~[01])*)*$",
      "maxLength": 1024
    },
    "nonempty_strings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "not": {
        "pattern": "(^/|^[A-Za-z]:|\\\\|\\.\\.)"
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
