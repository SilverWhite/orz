{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.fep-agent.invalid/schema/installation-key-metadata-v0.1.schema.json",
  "title": "Installation Key Metadata v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "metadata_kind",
    "key_id",
    "created_at",
    "key_algorithm",
    "key_bytes",
    "storage",
    "protected_blob_sha256",
    "secret_material_persisted_in_metadata",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0-draft" },
    "metadata_kind": { "const": "installation_key_metadata" },
    "key_id": { "type": "string", "pattern": "^KEY-[A-Z0-9._-]+$" },
    "created_at": { "type": "string", "format": "date-time" },
    "key_algorithm": { "const": "hmac-sha256" },
    "key_bytes": { "const": 32 },
    "storage": {
      "enum": ["windows-dpapi-current-user", "memory-test-only"]
    },
    "protected_blob_sha256": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      ]
    },
    "secret_material_persisted_in_metadata": { "const": false },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "storage": { "const": "windows-dpapi-current-user" } },
        "required": ["storage"]
      },
      "then": {
        "properties": {
          "protected_blob_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "else": {
        "properties": { "protected_blob_sha256": { "type": "null" } }
      }
    }
  ]
}
