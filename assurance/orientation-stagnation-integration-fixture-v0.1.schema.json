{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.scientific-assurance.invalid/schema/orientation-stagnation-integration-fixture-v0.1.schema.json",
  "title": "Orientation/stagnation integration fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_kind",
    "task_id",
    "task_contract_sha256",
    "step_index",
    "public_outputs",
    "retry_count",
    "retry_budget",
    "thresholds",
    "progress_markers"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0-draft" },
    "fixture_kind": { "const": "orientation_stagnation_integration_fixture" },
    "task_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9._-]*$" },
    "task_contract_sha256": { "$ref": "#/$defs/sha256" },
    "step_index": { "type": "integer", "minimum": 0 },
    "public_outputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonempty" }
    },
    "retry_count": { "type": "integer", "minimum": 0 },
    "retry_budget": { "type": "integer", "minimum": 0 },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repeated_content_threshold",
        "ngram_repeat_threshold"
      ],
      "properties": {
        "repeated_content_threshold": { "type": "integer", "minimum": 1 },
        "ngram_repeat_threshold": { "type": "integer", "minimum": 1 }
      }
    },
    "progress_markers": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonempty" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
