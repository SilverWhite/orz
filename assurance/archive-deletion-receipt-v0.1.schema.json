{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.fep-agent.invalid/schema/archive-deletion-receipt-v0.1.schema.json",
  "title": "Signed Archive Deletion Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_kind",
    "receipt_id",
    "conversation_id",
    "envelope_id",
    "created_at",
    "outcome",
    "archive_complete",
    "policy_sha256",
    "categories",
    "totals",
    "errors",
    "integrity"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0-draft" },
    "receipt_kind": { "const": "archive_deletion_receipt" },
    "receipt_id": { "type": "string", "pattern": "^DEL-[A-Z0-9._-]+$" },
    "conversation_id": { "type": "string", "pattern": "^CONV-[A-Z0-9._-]+$" },
    "envelope_id": { "type": "string", "pattern": "^ENV-[A-Z0-9._-]+$" },
    "created_at": { "type": "string", "format": "date-time" },
    "outcome": { "enum": ["archived", "failed"] },
    "archive_complete": { "type": "boolean" },
    "policy_sha256": { "$ref": "#/$defs/sha256" },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "discovered_count",
          "deleted_count",
          "remaining_count",
          "deleted_content_aggregate_sha256"
        ],
        "properties": {
          "category": { "type": "string", "minLength": 1 },
          "discovered_count": { "type": "integer", "minimum": 0 },
          "deleted_count": { "type": "integer", "minimum": 0 },
          "remaining_count": { "type": "integer", "minimum": 0 },
          "deleted_content_aggregate_sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovered", "deleted", "remaining"],
      "properties": {
        "discovered": { "type": "integer", "minimum": 0 },
        "deleted": { "type": "integer", "minimum": 0 },
        "remaining": { "type": "integer", "minimum": 0 }
      }
    },
    "errors": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "code"],
        "properties": {
          "category": { "type": "string", "minLength": 1 },
          "code": { "enum": ["delete_failed", "unsafe_entry", "count_mismatch"] }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_id",
        "algorithm",
        "signed_payload_sha256",
        "signature"
      ],
      "properties": {
        "key_id": { "type": "string", "pattern": "^KEY-[A-Z0-9._-]+$" },
        "algorithm": { "const": "hmac-sha256" },
        "signed_payload_sha256": { "$ref": "#/$defs/sha256" },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "outcome": { "const": "archived" } },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "archive_complete": { "const": true },
          "totals": {
            "properties": { "remaining": { "const": 0 } }
          },
          "errors": { "maxItems": 0 }
        }
      },
      "else": {
        "properties": {
          "archive_complete": { "const": false },
          "errors": { "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
