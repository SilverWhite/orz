{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.fep-agent.invalid/schema/action-kernel-result-v0.1.schema.json",
  "title": "Action Kernel Cross-File Verification Result v0.1",
  "description": "Unified cross-file verification summary for an action kernel output root (GAK-05).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_kind",
    "result_id",
    "created_at",
    "output_root",
    "valid",
    "verifier_version",
    "artifacts",
    "checks",
    "errors",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0-draft" },
    "result_kind": { "const": "action_kernel_cross_file_verification" },
    "result_id": { "type": "string", "pattern": "^AKR-[A-Z0-9._-]+$" },
    "created_at": { "type": "string", "minLength": 1 },
    "output_root": { "type": "string", "minLength": 1 },
    "valid": { "type": "boolean" },
    "verifier_version": { "const": "0.1.0" },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run-manifest",
        "events.jsonl",
        "windows-process-result",
        "session-record"
      ],
      "properties": {
        "run-manifest": {
          "type": "object",
          "required": ["path", "sha256", "run_id"],
          "properties": {
            "path": { "type": "string" },
            "sha256": { "type": "string" },
            "run_id": { "type": "string" }
          }
        },
        "events.jsonl": {
          "type": "object",
          "required": ["path", "sha256", "event_count", "terminal_event"],
          "properties": {
            "path": { "type": "string" },
            "sha256": { "type": "string" },
            "event_count": { "type": "integer", "minimum": 0 },
            "terminal_event": { "type": ["string", "null"] }
          }
        },
        "windows-process-result": {
          "type": "object",
          "required": ["path", "sha256"],
          "properties": {
            "path": { "type": "string" },
            "sha256": { "type": "string" },
            "exit_code": { "type": ["integer", "null"] },
            "terminal_state": { "type": ["string", "null"] }
          }
        },
        "session-record": {
          "type": "object",
          "required": ["path", "sha256", "session_id"],
          "properties": {
            "path": { "type": "string" },
            "sha256": { "type": "string" },
            "session_id": { "type": "string" }
          }
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "manifest_present",
        "journal_present",
        "journal_replay_valid",
        "exactly_one_terminal",
        "run_id_process_matches",
        "run_id_session_matches",
        "no_model_or_tool_events"
      ],
      "properties": {
        "manifest_present": { "type": "boolean" },
        "manifest_valid": { "type": "boolean" },
        "journal_present": { "type": "boolean" },
        "journal_replay_valid": { "type": "boolean" },
        "journal_hash_chain_valid": { "type": "boolean" },
        "exactly_one_terminal": { "type": "boolean" },
        "process_result_present": { "type": "boolean" },
        "process_result_valid": { "type": "boolean" },
        "session_record_present": { "type": "boolean" },
        "session_record_valid": { "type": "boolean" },
        "artifact_events_present": { "type": "boolean" },
        "run_id_process_matches": { "type": "boolean" },
        "run_id_session_matches": { "type": "boolean" },
        "manifest_digest_process_matches": { "type": "boolean" },
        "session_journal_head_matches": { "type": "boolean" },
        "terminal_state_mapping": { "type": "boolean" },
        "no_model_or_tool_events": { "type": "boolean" },
        "artifact_count_from_journal": { "type": "integer", "minimum": -1 }
      }
    },
    "errors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
