{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.scientific-assurance.invalid/schema/deepseek-api-observation-pipeline-receipt-v0.1.schema.json",
  "title": "DeepSeek API observation pipeline receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_kind",
    "valid",
    "api_result",
    "artifacts",
    "decisions",
    "checks",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0-draft" },
    "receipt_kind": { "const": "deepseek_api_observation_pipeline_receipt" },
    "valid": { "const": true },
    "api_result": { "$ref": "#/$defs/artifact" },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner_public_output_extraction",
        "orientation_stagnation_integration",
        "orientation_stagnation_journal"
      ],
      "properties": {
        "runner_public_output_extraction": { "$ref": "#/$defs/receipt_artifact" },
        "orientation_stagnation_integration": { "$ref": "#/$defs/receipt_artifact" },
        "orientation_stagnation_journal": { "$ref": "#/$defs/receipt_artifact" }
      }
    },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_output_count",
        "stagnation_decision",
        "stagnation_action",
        "terminal_event_type"
      ],
      "properties": {
        "public_output_count": { "type": "integer", "minimum": 1 },
        "stagnation_decision": { "enum": ["continue", "restart_requested", "handoff_required"] },
        "stagnation_action": { "type": "string", "minLength": 1 },
        "terminal_event_type": { "enum": ["run_finished", "run_invalidated"] }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_invoked",
        "network_requested",
        "request_count_one",
        "retry_count_zero",
        "credential_value_recorded",
        "raw_response_recorded",
        "hidden_chain_of_thought_saved",
        "public_output_only_for_restart",
        "orientation_counterexample_disabled"
      ],
      "properties": {
        "model_invoked": { "const": true },
        "network_requested": { "const": true },
        "request_count_one": { "const": true },
        "retry_count_zero": { "const": true },
        "credential_value_recorded": { "const": false },
        "raw_response_recorded": { "const": false },
        "hidden_chain_of_thought_saved": { "const": false },
        "public_output_only_for_restart": { "const": true },
        "orientation_counterexample_disabled": { "const": true }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "receipt_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "receipt_sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "receipt_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
