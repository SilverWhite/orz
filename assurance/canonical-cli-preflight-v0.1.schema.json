{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.scientific-assurance.invalid/schema/canonical-cli-preflight-v0.1.schema.json",
  "title": "Canonical guarded CLI run_preflight event payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adapter_id",
    "provider",
    "model_id",
    "real_network_allowed",
    "source_visibility_gate_required",
    "instruction_provenance_gate_applied",
    "tool_availability_gate_applied",
    "task_contract_sha256"
  ],
  "properties": {
    "adapter_id": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "model_id": { "type": "string", "minLength": 1 },
    "real_network_allowed": { "type": "boolean" },
    "source_visibility_gate_required": { "type": "boolean" },
    "instruction_provenance_gate_applied": { "type": "boolean" },
    "tool_availability_gate_applied": { "type": "boolean" },
    "task_contract_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
