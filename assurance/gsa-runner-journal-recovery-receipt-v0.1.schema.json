{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.scientific-assurance.invalid/schema/gsa-runner-journal-recovery-receipt-v0.1.schema.json",
  "title": "GSA runner journal recovery receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_kind",
    "valid",
    "recovery_id",
    "classification",
    "run_id",
    "run_manifest_sha256",
    "original_journal_sha256",
    "original_size_bytes",
    "retained_size_bytes",
    "discarded_offset_bytes",
    "discarded_size_bytes",
    "discarded_sha256",
    "quarantine_path",
    "quarantine_sha256",
    "receipt_path",
    "final_journal_sha256",
    "final_event_count",
    "final_last_event_sha256",
    "final_terminal_event",
    "repaired_under_lock",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft"
    },
    "receipt_kind": {
      "const": "gsa_runner_journal_recovery_receipt"
    },
    "valid": {
      "const": true
    },
    "recovery_id": {
      "type": "string",
      "pattern": "^JRR-[A-F0-9]{16}$"
    },
    "classification": {
      "enum": [
        "missing_newline_normalized",
        "torn_tail_removed"
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^RUN-[A-Z0-9._-]+$"
    },
    "run_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "original_journal_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "original_size_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "retained_size_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "discarded_offset_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "discarded_size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "discarded_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "quarantine_path": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "quarantine_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "receipt_path": {
      "type": "string",
      "minLength": 1
    },
    "final_journal_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "final_event_count": {
      "type": "integer",
      "minimum": 1
    },
    "final_last_event_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "final_terminal_event": {
      "type": [
        "string",
        "null"
      ]
    },
    "repaired_under_lock": {
      "const": true
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
