{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.fep.invalid/runtime/network-confirmation-summary/v0.1/schema.json",
  "title": "Redacted External Network Confirmation Summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "provider", "endpoint", "billable_external_request",
    "turn", "attempt", "is_retry", "previous_status", "model",
    "request_body_bytes", "request_body_sha256", "message_count", "message_roles",
    "tool_definition_count", "tool_result_message_count", "private_reasoning_message_count",
    "stream", "response_format", "max_tokens", "disclosure", "bounds"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0-prototype" },
    "provider": { "const": "deepseek" },
    "endpoint": { "const": "https://api.deepseek.com/chat/completions" },
    "billable_external_request": { "const": true },
    "turn": { "type": "integer", "minimum": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "is_retry": { "type": "boolean" },
    "previous_status": {
      "oneOf": [
        { "type": "integer", "minimum": 100, "maximum": 599 },
        { "type": "null" }
      ]
    },
    "model": { "enum": ["deepseek-v4-pro", "deepseek-v4-flash"] },
    "request_body_bytes": { "type": "integer", "minimum": 1 },
    "request_body_sha256": { "$ref": "#/$defs/sha256" },
    "message_count": { "type": "integer", "minimum": 1 },
    "message_roles": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["system", "user", "assistant", "tool"] }
    },
    "tool_definition_count": { "type": "integer", "minimum": 0 },
    "tool_result_message_count": { "type": "integer", "minimum": 0 },
    "private_reasoning_message_count": { "type": "integer", "minimum": 0 },
    "stream": { "const": true },
    "response_format": {
      "oneOf": [{ "enum": ["json_object"] }, { "type": "null" }]
    },
    "max_tokens": {
      "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sends_message_content", "sends_tool_definitions", "sends_provider_private_reasoning",
        "raw_message_content_recorded_in_summary", "raw_reasoning_recorded_in_summary",
        "authorization_recorded_in_summary"
      ],
      "properties": {
        "sends_message_content": { "type": "boolean" },
        "sends_tool_definitions": { "type": "boolean" },
        "sends_provider_private_reasoning": { "type": "boolean" },
        "raw_message_content_recorded_in_summary": { "const": false },
        "raw_reasoning_recorded_in_summary": { "const": false },
        "authorization_recorded_in_summary": { "const": false }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connect_seconds", "first_semantic_seconds", "total_seconds",
        "max_request_bytes", "max_response_bytes"
      ],
      "properties": {
        "connect_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "first_semantic_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "total_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "max_request_bytes": { "type": "integer", "minimum": 1 },
        "max_response_bytes": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "attempt": { "const": 1 } }, "required": ["attempt"] },
      "then": {
        "properties": {
          "is_retry": { "const": false },
          "previous_status": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "is_retry": { "const": true },
          "previous_status": { "type": "integer", "minimum": 100, "maximum": 599 }
        }
      }
    }
  ]
}
