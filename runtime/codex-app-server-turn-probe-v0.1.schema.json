{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-assurance.local/schema/codex-app-server-turn-probe-v0.1.schema.json",
  "title": "Codex app-server synthetic turn probe receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "probe_id", "supervisor_id",
    "valid", "probe_status", "runtime_family", "runtime_version",
    "source_stream_id", "started_at", "finished_at", "command_sha256",
    "working_directory", "isolated_state_directory", "process_id",
    "process_exit_code", "shutdown_method", "containment_kind",
    "containment_assigned", "config_artifact", "provider", "lifecycle",
    "capture_artifact", "record_count", "stderr_artifact", "error_kind",
    "error_sha256", "limitations"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "artifact_kind": { "const": "codex-app-server-turn-probe" },
    "probe_id": {
      "type": "string",
      "pattern": "^CLIPROBE-CODEX-[A-Z0-9._-]+$"
    },
    "supervisor_id": {
      "const": "CLIPROBE-CODEX-APP-SERVER-TURN-V0.1"
    },
    "valid": { "type": "boolean" },
    "probe_status": { "enum": ["captured", "failed"] },
    "runtime_family": { "const": "codex-app-server" },
    "runtime_version": { "type": "string", "minLength": 1 },
    "source_stream_id": {
      "type": "string",
      "pattern": "^CLISTREAM-[A-Z0-9._-]+$"
    },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "command_sha256": { "$ref": "#/$defs/sha256" },
    "working_directory": { "type": "string", "minLength": 1 },
    "isolated_state_directory": { "type": "string", "minLength": 1 },
    "process_id": { "type": ["integer", "null"], "minimum": 1 },
    "process_exit_code": { "type": ["integer", "null"] },
    "shutdown_method": {
      "enum": [
        "not_started", "natural_exit", "stdin_eof", "process_tree_close",
        "process_group_terminate", "root_terminate", "process_group_kill",
        "root_kill"
      ]
    },
    "containment_kind": { "enum": ["windows_job", "process_group"] },
    "containment_assigned": { "type": "boolean" },
    "config_artifact": { "$ref": "#/$defs/artifact" },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id", "model", "response_mode", "base_url",
        "request_count", "request", "synthetic_input_sha256",
        "synthetic_output_sha256", "sse_sha256"
      ],
      "properties": {
        "provider_id": { "const": "lif_lifecycle_loopback" },
        "model": { "const": "gpt-5.4" },
        "response_mode": {
          "enum": ["success", "http_error", "stall"]
        },
        "base_url": {
          "type": ["string", "null"],
          "pattern": "^http://127\\.0\\.0\\.1:<ephemeral>/v1$"
        },
        "request_count": { "type": "integer", "minimum": 0 },
        "request": {
          "oneOf": [
            { "$ref": "#/$defs/provider_request" },
            { "type": "null" }
          ]
        },
        "synthetic_input_sha256": { "$ref": "#/$defs/sha256" },
        "synthetic_output_sha256": { "$ref": "#/$defs/sha256" },
        "sse_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminal_scenario", "initialize_response_received", "initialized_sent",
        "thread_start_response_received", "thread_started_received",
        "thread_id", "turn_start_response_received",
        "turn_started_received", "interrupt_request_sent",
        "interrupt_response_received", "turn_completed_received", "turn_id",
        "terminal_status", "thread_unsubscribe_request_sent",
        "thread_unsubscribe_response_received", "thread_closed_received"
      ],
      "properties": {
        "terminal_scenario": {
          "enum": ["completed", "failed", "interrupted", "closed"]
        },
        "initialize_response_received": { "type": "boolean" },
        "initialized_sent": { "type": "boolean" },
        "thread_start_response_received": { "type": "boolean" },
        "thread_started_received": { "type": "boolean" },
        "thread_id": { "type": ["string", "null"], "minLength": 1 },
        "turn_start_response_received": { "type": "boolean" },
        "turn_started_received": { "type": "boolean" },
        "interrupt_request_sent": { "type": "boolean" },
        "interrupt_response_received": { "type": "boolean" },
        "turn_completed_received": { "type": "boolean" },
        "turn_id": { "type": ["string", "null"], "minLength": 1 },
        "terminal_status": {
          "type": ["string", "null"],
          "enum": ["completed", "interrupted", "failed", null]
        },
        "thread_unsubscribe_request_sent": { "type": "boolean" },
        "thread_unsubscribe_response_received": { "type": "boolean" },
        "thread_closed_received": { "type": "boolean" }
      }
    },
    "capture_artifact": { "$ref": "#/$defs/artifact" },
    "record_count": { "type": "integer", "minimum": 0 },
    "stderr_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "bytes", "sha256", "total_bytes", "full_sha256", "truncated"
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "total_bytes": { "type": "integer", "minimum": 0 },
        "full_sha256": { "$ref": "#/$defs/sha256" },
        "truncated": { "type": "boolean" }
      }
    },
    "error_kind": { "type": ["string", "null"], "minLength": 1 },
    "error_sha256": {
      "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "provider_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method", "path", "client_host", "body_bytes", "body_sha256",
        "model", "stream", "input_marker_present", "accepts_event_stream",
        "authorization_present"
      ],
      "properties": {
        "method": { "const": "POST" },
        "path": { "type": "string", "minLength": 1 },
        "client_host": { "type": "string", "minLength": 1 },
        "body_bytes": { "type": "integer", "minimum": 1 },
        "body_sha256": { "$ref": "#/$defs/sha256" },
        "model": { "type": ["string", "null"] },
        "stream": { "type": ["boolean", "null"] },
        "input_marker_present": { "type": "boolean" },
        "accepts_event_stream": { "type": "boolean" },
        "authorization_present": { "type": "boolean" }
      }
    }
  }
}
