{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-assurance.local/schema/cli-session-lifecycle-adapter-verification-v0.2.schema.json",
  "title": "CLI session lifecycle adapter verification v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "valid", "adapter_status",
    "observation_id", "receipt_sha256", "journal_sha256", "checks",
    "errors", "limitations"
  ],
  "properties": {
    "schema_version": { "const": "0.2.0" },
    "artifact_kind": { "const": "cli-session-lifecycle-adapter-verification" },
    "valid": { "type": "boolean" },
    "adapter_status": {
      "type": ["string", "null"],
      "enum": ["appended", "already_recorded", "conflict", "rejected", null]
    },
    "observation_id": {
      "type": ["string", "null"],
      "pattern": "^CLIOBS-[A-Z0-9._-]+$"
    },
    "receipt_sha256": { "$ref": "#/$defs/sha256" },
    "journal_sha256": {
      "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_schema_valid", "observation_valid",
        "observation_digest_matches", "journal_valid",
        "journal_snapshot_matches", "event_presence_verified",
        "lifecycle_projection_verified", "adapter_status_consistent"
      ],
      "properties": {
        "receipt_schema_valid": { "type": "boolean" },
        "observation_valid": { "type": "boolean" },
        "observation_digest_matches": { "type": "boolean" },
        "journal_valid": { "type": "boolean" },
        "journal_snapshot_matches": { "type": "boolean" },
        "event_presence_verified": { "type": "boolean" },
        "lifecycle_projection_verified": { "type": "boolean" },
        "adapter_status_consistent": { "type": "boolean" }
      }
    },
    "errors": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
