{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.fep-agent.invalid/schema/scenario-instance-v0.1.schema.json",
  "title": "FEP Agent Exported Scenario Instance v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_token",
    "mode",
    "task",
    "visible_facts",
    "fixtures"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0-draft" },
    "scenario_token": { "type": "string", "pattern": "^SCN-[a-f0-9]{16}$" },
    "mode": { "enum": ["discussion", "guarded", "strict"] },
    "task": { "type": "string", "minLength": 1 },
    "visible_facts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "media_type", "role", "sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/relativePath" },
          "media_type": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    }
  }
}
