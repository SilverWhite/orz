{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.fep-agent.invalid/schema/control-ticket-issued-event-payload-v0.2.schema.json",
  "title": "Control ticket issued runtime event payload v0.2",
  "description": "ACAF Slice 1 (设计文档 §4.2（ADR-0011 §2）): a one-time HMAC-SHA256 ControlTicket was issued by the independent signer for a control event (orientation / disposition / close / goal revision). ACAF Slice 2 (2026-08-12): action tickets file_write / credential_read / command_exec / network join the same issued/consumed/rejected lifecycle — action kinds carry resolved_target_sha256 (the digest of the parsed real target object, §4.2 check 5 TOCTOU), control kinds leave it null or absent (historical journals stay valid). The journal records the issue fact and the binding fields — never the HMAC tag, which stays inside the issuing process. Binding fields are re-derived by the verifier; template_sha256 is non-null only for orientation (signer-held template, §4.2 check 2). GAP-EVENT-SCHEMA-DRIFT (2026-08-26, D-13 检索 lane 绑定语义入 schema): 动作票 activation_id 由「强制 null」放开为「可选绑定」——子代理检索 lane 内的动作票（web_fetch/browser_read 等 network_v1）携带真实 activation_id（D-13 必须绑定），主 lane 动作票保持 null；签发器侧 `forbids_activation()` 仅 Orientation 唯一禁止（2026-08-13 已实施，本 schema 与之一致）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ticket_id",
    "ticket_kind",
    "session_id",
    "agent_id",
    "activation_id",
    "goal_version",
    "goal_digest",
    "policy_revision",
    "sequence",
    "capability_scope",
    "template_sha256",
    "canonical_arguments_sha256",
    "issued_at",
    "expires_at",
    "signer_revision",
    "signer_measurement"
  ],
  "properties": {
    "ticket_id": { "type": "string", "pattern": "^TKT-[A-Za-z0-9._-]+$" },
    "ticket_kind": {
      "type": "string",
      "enum": [
        "orientation_v1",
        "disposition_v1",
        "close_v1",
        "goal_revision_v1",
        "file_write_v1",
        "credential_read_v1",
        "command_exec_v1",
        "network_v1"
      ]
    },
    "session_id": { "type": "string", "minLength": 1 },
    "agent_id": { "type": "string", "minLength": 1 },
    "activation_id": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "goal_version": { "type": "integer", "minimum": 0 },
    "goal_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "policy_revision": { "type": "integer", "minimum": 0 },
    "sequence": { "type": "integer", "minimum": 0 },
    "capability_scope": {
      "type": "string",
      "enum": [
        "orientation_injection",
        "disposition_submit",
        "close_record",
        "goal_revision",
        "file_write",
        "credential_read",
        "command_exec",
        "network"
      ]
    },
    "resolved_target_sha256": {
      "oneOf": [
        { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        { "type": "null" }
      ]
    },
    "template_sha256": {
      "oneOf": [
        { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        { "type": "null" }
      ]
    },
    "canonical_arguments_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "signer_revision": { "type": "integer", "minimum": 0 },
    "signer_measurement": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "ticket_kind": { "const": "orientation_v1" } }, "required": ["ticket_kind"] },
      "then": { "properties": { "template_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
      "else": { "properties": { "template_sha256": { "type": "null" } } }
    },
    {
      "if": { "properties": { "ticket_kind": { "const": "orientation_v1" } }, "required": ["ticket_kind"] },
      "then": {
        "properties": { "capability_scope": { "const": "orientation_injection" } }
      }
    },
    {
      "if": { "properties": { "ticket_kind": { "const": "disposition_v1" } }, "required": ["ticket_kind"] },
      "then": {
        "properties": { "capability_scope": { "const": "disposition_submit" } }
      }
    },
    {
      "if": { "properties": { "ticket_kind": { "const": "close_v1" } }, "required": ["ticket_kind"] },
      "then": {
        "properties": { "capability_scope": { "const": "close_record" } }
      }
    },
    {
      "if": { "properties": { "ticket_kind": { "const": "goal_revision_v1" } }, "required": ["ticket_kind"] },
      "then": {
        "properties": { "capability_scope": { "const": "goal_revision" } }
      }
    },
    {
      "if": { "properties": { "ticket_kind": { "const": "file_write_v1" } }, "required": ["ticket_kind"] },
      "then": {
        "properties": { "capability_scope": { "const": "file_write" } }
      }
    },
    {
      "if": { "properties": { "ticket_kind": { "const": "credential_read_v1" } }, "required": ["ticket_kind"] },
      "then": {
        "properties": { "capability_scope": { "const": "credential_read" } }
      }
    },
    {
      "if": { "properties": { "ticket_kind": { "const": "command_exec_v1" } }, "required": ["ticket_kind"] },
      "then": {
        "properties": { "capability_scope": { "const": "command_exec" } }
      }
    },
    {
      "if": { "properties": { "ticket_kind": { "const": "network_v1" } }, "required": ["ticket_kind"] },
      "then": {
        "properties": { "capability_scope": { "const": "network" } }
      }
    },
    {
      "if": { "properties": { "ticket_kind": { "const": "orientation_v1" } }, "required": ["ticket_kind"] },
      "then": {
        "properties": { "activation_id": { "type": "null" } }
      }
    },
    {
      "if": {
        "properties": { "ticket_kind": { "enum": ["disposition_v1", "close_v1", "goal_revision_v1"] } },
        "required": ["ticket_kind"]
      },
      "then": {
        "properties": { "activation_id": { "type": "string", "minLength": 1 } }
      }
    },
    {
      "if": {
        "properties": { "ticket_kind": { "enum": ["file_write_v1", "credential_read_v1", "command_exec_v1", "network_v1"] } },
        "required": ["ticket_kind"]
      },
      "then": {
        "properties": {
          "activation_id": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              { "type": "null" }
            ],
            "description": "D-13 lane binding: null = main-lane action; string = action bound to a sub-agent retrieval lane activation (external/internal retrieval must bind, main lane keeps null)."
          }
        }
      }
    },
    {
      "if": {
        "properties": { "ticket_kind": { "enum": ["file_write_v1", "credential_read_v1", "command_exec_v1", "network_v1"] } },
        "required": ["ticket_kind"]
      },
      "then": {
        "required": ["resolved_target_sha256"],
        "properties": { "resolved_target_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
      }
    },
    {
      "if": {
        "properties": { "ticket_kind": { "enum": ["orientation_v1", "disposition_v1", "close_v1", "goal_revision_v1"] } },
        "required": ["ticket_kind"]
      },
      "then": {
        "properties": { "resolved_target_sha256": { "type": "null" } }
      }
    }
  ]
}
