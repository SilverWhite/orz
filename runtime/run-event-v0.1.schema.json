{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.fep-agent.invalid/schema/run-event-v0.1.schema.json",
  "title": "FEP Agent Append-only Run Event v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "event_id",
    "sequence",
    "timestamp",
    "event_type",
    "run_manifest_sha256",
    "previous_event_sha256",
    "payload_schema",
    "payload",
    "payload_sha256",
    "redaction",
    "event_sha256"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0-draft" },
    "run_id": { "type": "string", "pattern": "^RUN-[A-Z0-9._-]+$" },
    "event_id": { "type": "string", "pattern": "^EVT-[A-Z0-9._-]+$" },
    "sequence": { "type": "integer", "minimum": 0 },
    "timestamp": { "type": "string", "format": "date-time" },
    "event_type": {
      "enum": [
        "run_preflight",
        "run_started",
        "model_request",
        "model_output",
        "tool_proposal",
        "permission_decision",
        "tool_started",
        "tool_completed",
        "gate_decision",
        "artifact_registered",
        "run_finished",
        "run_failed",
        "run_cancelled",
        "run_invalidated"
      ]
    },
    "run_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "previous_event_sha256": {
      "oneOf": [
        { "$ref": "#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "payload_schema": { "type": "string", "minLength": 1 },
    "payload": { "type": "object" },
    "payload_sha256": { "$ref": "#/$defs/sha256" },
    "redaction": { "enum": ["none", "metadata_only", "content_redacted"] },
    "event_sha256": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": { "properties": { "sequence": { "const": 0 } }, "required": ["sequence"] },
      "then": { "properties": { "previous_event_sha256": { "type": "null" } } },
      "else": { "properties": { "previous_event_sha256": { "$ref": "#/$defs/sha256" } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
