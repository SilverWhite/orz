{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-assurance.local/schema/cli-session-lifecycle-adapter-receipt-v0.2.schema.json",
  "title": "CLI session lifecycle adapter receipt v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "adapter_status", "valid",
    "observation_id", "observation_sha256", "run_id", "session_id",
    "lifecycle_state_before", "lifecycle_state_after", "active_turn_id",
    "turn_status", "error_sha256", "canonical_event_type", "event_sha256",
    "journal_sha256", "journal_event_count", "errors", "limitations"
  ],
  "properties": {
    "schema_version": { "const": "0.2.0" },
    "artifact_kind": { "const": "cli-session-lifecycle-adapter-receipt" },
    "adapter_status": {
      "enum": ["appended", "already_recorded", "conflict", "rejected"]
    },
    "valid": { "type": "boolean" },
    "observation_id": {
      "type": ["string", "null"],
      "pattern": "^CLIOBS-[A-Z0-9._-]+$"
    },
    "observation_sha256": {
      "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "run_id": {
      "type": ["string", "null"],
      "pattern": "^RUN-[A-Z0-9._-]+$"
    },
    "session_id": { "type": ["string", "null"], "minLength": 1 },
    "lifecycle_state_before": {
      "type": ["string", "null"],
      "enum": ["new", "active", "in_turn", "terminal", null]
    },
    "lifecycle_state_after": {
      "type": ["string", "null"],
      "enum": ["new", "active", "in_turn", "terminal", null]
    },
    "active_turn_id": { "type": ["string", "null"], "minLength": 1 },
    "turn_status": {
      "type": ["string", "null"],
      "enum": ["completed", "interrupted", "failed", null]
    },
    "error_sha256": {
      "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "canonical_event_type": {
      "type": ["string", "null"],
      "enum": [
        "run_started", "model_request", "model_output", "run_finished",
        "run_failed", "run_cancelled", null
      ]
    },
    "event_sha256": {
      "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "journal_sha256": {
      "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "journal_event_count": { "type": ["integer", "null"], "minimum": 0 },
    "errors": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
