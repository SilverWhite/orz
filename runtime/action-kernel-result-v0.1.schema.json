{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.fep.invalid/runtime/action-kernel-result/v0.1/schema.json",
  "title": "Action Kernel Integration Spike Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kernel",
    "run_id",
    "valid",
    "runtime_ready",
    "action_state",
    "terminal_run_event",
    "session_validation",
    "journal_replay",
    "artifacts",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0-prototype" },
    "kernel": { "const": "windows-local-process-action-spike" },
    "run_id": { "type": "string", "pattern": "^RUN-[A-Z0-9._-]+$" },
    "valid": { "type": "boolean" },
    "runtime_ready": { "type": "boolean" },
    "action_state": { "enum": ["succeeded", "failed", "cancelled", "unknown"] },
    "terminal_run_event": {
      "enum": ["run_finished", "run_failed", "run_cancelled", "run_invalidated"]
    },
    "session_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "violation_count"],
      "properties": {
        "valid": { "type": "boolean" },
        "violation_count": { "type": "integer", "minimum": 0 }
      }
    },
    "journal_replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "event_count", "terminal_event"],
      "properties": {
        "valid": { "type": "boolean" },
        "event_count": { "type": "integer", "minimum": 1 },
        "terminal_event": {
          "enum": ["run_finished", "run_failed", "run_cancelled", "run_invalidated"]
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_manifest", "journal", "process_result", "session_record"],
      "properties": {
        "run_manifest": { "$ref": "#/$defs/artifact" },
        "journal": { "$ref": "#/$defs/artifact" },
        "process_result": { "$ref": "#/$defs/artifact" },
        "session_record": { "$ref": "#/$defs/artifact" }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
