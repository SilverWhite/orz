{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.fep.invalid/runtime/model-loop-result/v0.1/schema.json",
  "title": "Mock DeepSeek Model Loop Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "loop",
    "run_id",
    "valid",
    "runtime_ready",
    "provider",
    "model",
    "transport",
    "real_network",
    "private_transcript_persisted",
    "request_count",
    "http_attempt_count",
    "retry_count",
    "tool_call_count",
    "reasoning_continuity_checked",
    "turns",
    "final_output",
    "journal_replay",
    "artifacts",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0-prototype" },
    "loop": { "const": "deepseek-mock-tool-loop" },
    "run_id": { "type": "string", "pattern": "^RUN-[A-Z0-9._-]+$" },
    "valid": { "type": "boolean" },
    "runtime_ready": { "type": "boolean" },
    "provider": { "const": "deepseek" },
    "model": { "enum": ["deepseek-v4-pro", "deepseek-v4-flash"] },
    "transport": { "enum": ["scripted-no-network-v0.1", "loopback-http-v0.1", "deepseek-brokered-fake-https-v0.1"] },
    "real_network": { "const": false },
    "private_transcript_persisted": { "type": "boolean" },
    "request_count": { "type": "integer", "minimum": 1 },
    "http_attempt_count": { "type": "integer", "minimum": 1 },
    "retry_count": { "type": "integer", "minimum": 0 },
    "tool_call_count": { "type": "integer", "minimum": 0 },
    "reasoning_continuity_checked": { "type": "boolean" },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/turn" }
    },
    "final_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finish_reason", "content_bytes", "content_sha256"],
      "properties": {
        "finish_reason": { "const": "stop" },
        "content_bytes": { "type": "integer", "minimum": 1 },
        "content_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "journal_replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "event_count", "terminal_event"],
      "properties": {
        "valid": { "type": "boolean" },
        "event_count": { "type": "integer", "minimum": 1 },
        "terminal_event": { "const": "run_finished" }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_manifest", "journal", "profile_snapshot", "private_transcript", "network_approval_ledger"],
      "properties": {
        "run_manifest": { "$ref": "#/$defs/artifact" },
        "journal": { "$ref": "#/$defs/artifact" },
        "profile_snapshot": { "$ref": "#/$defs/artifact" },
        "private_transcript": {
          "oneOf": [{ "$ref": "#/$defs/artifact" }, { "type": "null" }]
        },
        "network_approval_ledger": {
          "oneOf": [{ "$ref": "#/$defs/artifact" }, { "type": "null" }]
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt", "status", "category", "retryable", "transport_metadata"],
      "properties": {
        "attempt": { "type": "integer", "minimum": 1 },
        "status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "category": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "transport_metadata": { "type": "object" }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id_sha256", "name", "arguments_sha256"],
      "properties": {
        "id_sha256": { "$ref": "#/$defs/sha256" },
        "name": { "type": "string", "minLength": 1 },
        "arguments_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finish_reason",
        "content_bytes",
        "content_sha256",
        "reasoning_present",
        "reasoning_bytes",
        "reasoning_sha256",
        "tool_call_count",
        "tool_calls",
        "keep_alive_count",
        "data_event_count",
        "semantic_event_count",
        "usage",
        "raw_content_recorded",
        "raw_reasoning_recorded"
      ],
      "properties": {
        "finish_reason": { "enum": ["stop", "length", "content_filter", "tool_calls", "insufficient_system_resource"] },
        "content_bytes": { "type": "integer", "minimum": 0 },
        "content_sha256": { "$ref": "#/$defs/sha256" },
        "reasoning_present": { "type": "boolean" },
        "reasoning_bytes": { "type": "integer", "minimum": 0 },
        "reasoning_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "tool_call_count": { "type": "integer", "minimum": 0 },
        "tool_calls": { "type": "array", "items": { "$ref": "#/$defs/tool" } },
        "keep_alive_count": { "type": "integer", "minimum": 0 },
        "data_event_count": { "type": "integer", "minimum": 1 },
        "semantic_event_count": { "type": "integer", "minimum": 1 },
        "usage": { "type": ["object", "null"] },
        "raw_content_recorded": { "const": false },
        "raw_reasoning_recorded": { "const": false }
      }
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn", "request_sha256", "message_count", "reasoning_message_count", "attempts", "response"],
      "properties": {
        "turn": { "type": "integer", "minimum": 1 },
        "request_sha256": { "$ref": "#/$defs/sha256" },
        "message_count": { "type": "integer", "minimum": 1 },
        "reasoning_message_count": { "type": "integer", "minimum": 0 },
        "attempts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/attempt" } },
        "response": { "$ref": "#/$defs/response" }
      }
    }
  }
}
