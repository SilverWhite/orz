{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.scientific-assurance.invalid/schema/snapshot-created-event-payload-v0.1.schema.json",
  "title": "Snapshot created runtime event payload (IP5 pre-mutation snapshot)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tool",
    "targets"
  ],
  "properties": {
    "tool": { "type": "string", "minLength": 1 },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "snapshot_hash": { "$ref": "#/$defs/sha256" },
    "snapshot_error": { "type": "string", "minLength": 1 }
  },
  "anyOf": [
    { "required": ["snapshot_hash"] },
    { "required": ["snapshot_error"] }
  ],
  "allOf": [
    {
      "if": { "required": ["snapshot_hash"] },
      "then": { "not": { "required": ["snapshot_error"] } }
    },
    {
      "if": { "required": ["snapshot_error"] },
      "then": { "not": { "required": ["snapshot_hash"] } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
