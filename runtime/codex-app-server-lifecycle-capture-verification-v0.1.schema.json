{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-assurance.local/schema/codex-app-server-lifecycle-capture-verification-v0.1.schema.json",
  "title": "Codex app-server no-model capture verification v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "valid", "capture_id",
    "source_stream_id", "checks", "errors", "limitations"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "artifact_kind": {
      "const": "codex-app-server-lifecycle-capture-verification"
    },
    "valid": { "type": "boolean" },
    "capture_id": {
      "type": ["string", "null"],
      "pattern": "^CLICAP-CODEX-[A-Z0-9._-]+$"
    },
    "source_stream_id": {
      "type": ["string", "null"],
      "pattern": "^CLISTREAM-[A-Z0-9._-]+$"
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_schema_valid", "receipt_semantics_valid",
        "capture_artifact_matches", "capture_records_valid",
        "handshake_replayed", "no_model_input",
        "stderr_artifact_matches"
      ],
      "properties": {
        "receipt_schema_valid": { "type": "boolean" },
        "receipt_semantics_valid": { "type": "boolean" },
        "capture_artifact_matches": { "type": "boolean" },
        "capture_records_valid": { "type": "boolean" },
        "handshake_replayed": { "type": "boolean" },
        "no_model_input": { "type": "boolean" },
        "stderr_artifact_matches": { "type": "boolean" }
      }
    },
    "errors": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
