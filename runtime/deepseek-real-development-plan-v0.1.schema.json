{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.fep.invalid/runtime/deepseek-real-development-plan/v0.1/schema.json",
  "title": "DeepSeek Real Development One-Shot Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_kind",
    "created_at",
    "provider",
    "model",
    "credential",
    "request",
    "confirmation_summary",
    "confirmation_summary_sha256",
    "execution",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0-development" },
    "plan_kind": { "const": "deepseek-real-development-one-shot" },
    "created_at": { "type": "string", "minLength": 1 },
    "provider": { "const": "deepseek" },
    "model": { "const": "deepseek-v4-pro" },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "target", "value_recorded"],
      "properties": {
        "provider": { "const": "windows-credential-manager-current-user" },
        "target": { "const": "FEP-Agent/DeepSeek" },
        "value_recorded": { "const": false }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixed_prompt",
        "thinking",
        "tool_definition_count",
        "max_tokens",
        "retry_count",
        "expected_marker_sha256"
      ],
      "properties": {
        "fixed_prompt": { "const": true },
        "thinking": { "const": "disabled" },
        "tool_definition_count": { "const": 0 },
        "max_tokens": { "const": 16 },
        "retry_count": { "const": 0 },
        "expected_marker_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "confirmation_summary": { "type": "object" },
    "confirmation_summary_sha256": { "$ref": "#/$defs/sha256" },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network_attempted",
        "credential_read",
        "billable_request_made"
      ],
      "properties": {
        "network_attempted": { "const": false },
        "credential_read": { "const": false },
        "billable_request_made": { "const": false }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
