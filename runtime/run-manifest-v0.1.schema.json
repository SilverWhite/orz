{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.fep-agent.invalid/schema/run-manifest-v0.1.schema.json",
  "title": "FEP Agent Immutable Run Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_kind",
    "run_id",
    "created_at",
    "execution_mode",
    "scenario_export",
    "adapter",
    "prompts",
    "tools",
    "isolation",
    "budgets",
    "randomness",
    "protocol_digests",
    "journal_policy",
    "notes"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0-draft" },
    "manifest_kind": { "const": "immutable_precommit" },
    "run_id": { "type": "string", "pattern": "^RUN-[A-Z0-9._-]+$" },
    "created_at": { "type": "string", "format": "date-time" },
    "execution_mode": { "enum": ["development", "guarded", "strict", "regression_evaluation"] },
    "scenario_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["export_id", "manifest_sha256", "bundle_sha256", "leak_scan_report_sha256"],
      "properties": {
        "export_id": { "type": "string", "pattern": "^EXP-[A-Z0-9._-]+$" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "bundle_sha256": { "$ref": "#/$defs/sha256" },
        "leak_scan_report_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model_id", "adapter_id", "adapter_version", "capabilities"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model_id": { "type": "string", "minLength": 1 },
        "adapter_id": { "type": "string", "minLength": 1 },
        "adapter_version": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["structured_output", "tool_calling", "streaming", "seed_control", "cancellation", "context_limit_tokens"],
          "properties": {
            "structured_output": { "type": "boolean" },
            "tool_calling": { "type": "boolean" },
            "streaming": { "type": "boolean" },
            "seed_control": { "type": "boolean" },
            "cancellation": { "type": "boolean" },
            "context_limit_tokens": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "prompts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system_prompt_sha256", "project_rules_sha256", "generated_context_sha256"],
      "properties": {
        "system_prompt_sha256": { "$ref": "#/$defs/sha256" },
        "project_rules_sha256": { "$ref": "#/$defs/sha256" },
        "generated_context_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowlist", "policy_sha256", "permission_mode", "filesystem_profile", "network_profile"],
      "properties": {
        "allowlist": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "policy_sha256": { "$ref": "#/$defs/sha256" },
        "permission_mode": { "enum": ["interactive", "deny_by_default", "preapproved_narrow"] },
        "filesystem_profile": { "enum": ["workspace", "read_only", "strict_ephemeral", "custom"] },
        "network_profile": { "enum": ["disabled", "allowlisted", "unrestricted"] }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory",
        "historical_case_retrieval",
        "oracle_mounted",
        "reviewer_fixtures_mounted",
        "inherited_user_config",
        "writable_roots"
      ],
      "properties": {
        "memory": { "enum": ["disabled", "session_only", "enabled"] },
        "historical_case_retrieval": { "enum": ["disabled", "post_precommit_only", "enabled"] },
        "oracle_mounted": { "type": "boolean" },
        "reviewer_fixtures_mounted": { "type": "boolean" },
        "inherited_user_config": { "type": "boolean" },
        "writable_roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_time_seconds", "max_turns", "max_input_tokens", "max_output_tokens", "max_tool_calls"],
      "properties": {
        "wall_time_seconds": { "type": "integer", "minimum": 1 },
        "max_turns": { "type": "integer", "minimum": 1 },
        "max_input_tokens": { "type": "integer", "minimum": 1 },
        "max_output_tokens": { "type": "integer", "minimum": 1 },
        "max_tool_calls": { "type": "integer", "minimum": 0 }
      }
    },
    "randomness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "temperature", "retry_policy"],
      "properties": {
        "seed": { "type": ["integer", "null"] },
        "temperature": { "type": "number", "minimum": 0 },
        "retry_policy": { "enum": ["none", "transport_only", "precommitted_fixed_count"] }
      }
    },
    "protocol_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_protocol", "reason_codes", "gate_matrix", "scoring_protocol", "output_schema"],
      "properties": {
        "agent_protocol": { "$ref": "#/$defs/sha256" },
        "reason_codes": { "$ref": "#/$defs/sha256" },
        "gate_matrix": { "$ref": "#/$defs/sha256" },
        "scoring_protocol": { "$ref": "#/$defs/sha256" },
        "output_schema": { "$ref": "#/$defs/sha256" }
      }
    },
    "journal_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "event_schema_version", "canonicalization", "hash_chain", "redaction_policy_sha256"],
      "properties": {
        "format": { "const": "jsonl" },
        "event_schema_version": { "const": "0.1.0-draft" },
        "canonicalization": { "const": "RFC8785" },
        "hash_chain": { "const": "sha256" },
        "redaction_policy_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "execution_mode": { "const": "regression_evaluation" } }, "required": ["execution_mode"] },
      "then": {
        "properties": {
          "tools": {
            "properties": {
              "permission_mode": { "const": "deny_by_default" },
              "filesystem_profile": { "const": "strict_ephemeral" },
              "network_profile": { "const": "disabled" }
            }
          },
          "isolation": {
            "properties": {
              "memory": { "const": "disabled" },
              "historical_case_retrieval": { "const": "disabled" },
              "oracle_mounted": { "const": false },
              "reviewer_fixtures_mounted": { "const": false },
              "inherited_user_config": { "const": false }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
