{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.scientific-assurance.invalid/schema/write-control-review-event-payload-v0.2.schema.json",
  "title": "Write-control command review event payload (Rust track, v0.2)",
  "description": "0bw③（2026-09-27，WRITE_CONTROL_MECHANICAL_DESIGN §3.2/D5 后续扩展）：`run_terminal_cmd` 命令面机械审查（L2）的专用 journal 事件族——block/warn/allow 三分类逐命令结构化留痕（allow 也落账）。v1 文案留痕（block 拒绝文案／warn `[写入管控·提示]` 行随 tool 结果入 journal）继续有效；本事件族补结构化审计面。规则身份封闭集（schema 锁定，2026-09-27 复审）：safety-mechanism-flip / system-core-write / carrier-write（block 类）与 broad-destructive / elevation（warn 类）。review↔rule 分类配对由判官核证（schema 无法表达跨字段映射：Rust `verify_write_control_review` ↔ Python `_verify_v02_write_control_review` 同形）。best-effort 闸边界（设计 §9）不变。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tool",
    "call_id",
    "review",
    "rule",
    "detail",
    "command_sha256",
    "command_len"
  ],
  "properties": {
    "tool": {
      "type": "string",
      "enum": ["run_terminal_cmd"],
      "description": "审查所在命令执行入口（v1 唯一接线面；扩展须修订 WRITE_CONTROL_MECHANICAL_DESIGN §3.2）。"
    },
    "call_id": {
      "type": "string",
      "minLength": 1
    },
    "review": {
      "type": "string",
      "enum": ["allow", "warn", "block"]
    },
    "rule": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "detail": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "command_sha256": {
      "$ref": "#/$defs/sha256_hex",
      "description": "被审查命令的 sha256（与 tool_started 的原始 args 关联；命令原文不随本事件重复入账）。"
    },
    "command_len": {
      "type": "integer",
      "minimum": 1
    }
  },
  "$defs": {
    "sha256_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "review": { "const": "allow" } },
        "required": ["review"]
      },
      "then": {
        "properties": { "rule": { "type": "null" }, "detail": { "type": "null" } }
      }
    },
    {
      "if": {
        "properties": {
          "review": { "enum": ["warn", "block"] }
        },
        "required": ["review"]
      },
      "then": {
        "properties": {
          "rule": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "safety-mechanism-flip",
              "system-core-write",
              "carrier-write",
              "broad-destructive",
              "elevation"
            ]
          },
          "detail": { "type": "string", "minLength": 1 }
        }
      }
    }
  ]
}
